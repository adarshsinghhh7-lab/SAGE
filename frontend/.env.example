# ─────────────────────────────────────────────────────────────────────────
# S.A.G.E. FRONTEND environment template
# Copy to frontend/.env for local development (Vite loads .env from the
# frontend/ directory it runs in). NEVER commit real secrets.
# All VITE_-prefixed variables are inlined into the client bundle at build
# time. Backend-only vars (SAGE_MASTER_KEY, FIREBASE_SERVICE_ACCOUNT_KEY,
# PORT, …) belong in the root .env / backend deployment, NOT here.
# ─────────────────────────────────────────────────────────────────────────

# ── Frontend build-time API base ────────────────────────────────────────
# Default "/api" works in dev (Vite proxy) AND in the single-service
# deployment (backend serves frontend/dist/ + /api on one origin). For a
# split deployment (static frontend + separate API) set the FULL backend
# origin INCLUDING the /api prefix, e.g.
#   VITE_API_URL="https://sage-api.onrender.com/api"
# (the client appends endpoint paths directly to this value).
VITE_API_URL="/api"

# ── Client Firebase config (optional for local dev; REQUIRED for live) ──
# Without these the frontend falls back to clearly-labelled demo values and
# the app runs in local/sandbox mode.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# ── Optional: urgency-scoring ML microservice ──────────────────────────
VITE_ML_URL="http://localhost:5001/predict-urgency"
