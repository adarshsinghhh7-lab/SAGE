# ─────────────────────────────────────────────────────────────────────────
# S.A.G.E. environment template
# Copy to .env for local development, or set these in your hosting
# platform's dashboard (Render / Railway / Fly.io / Vercel / Netlify) for
# production. NEVER commit real secrets.
# ─────────────────────────────────────────────────────────────────────────

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ── Sealing Server (backend) ────────────────────────────────────────────
# Server-only AES-256 key that seals student identities. REQUIRED in
# production — the backend refuses to start without it (fail-closed).
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SAGE_MASTER_KEY=""

# When "true" the backend also serves the built React app (dist/) so the UI
# and /api share one origin (single-service deployment — recommended).
SERVE_STATIC=""

# Backend listen port. Hosting platforms inject this automatically.
PORT=5000

# ── Firebase (optional for dev; REQUIRED for real deployments) ──────────
# Without a service account the backend runs an in-memory sandbox and ALL
# data is lost on restart — never use that for real student grievances.
FIREBASE_SERVICE_ACCOUNT_KEY=""
FIREBASE_PROJECT_ID=""
# Alternative credential path: service-account JSON file or Application Default
# Credentials on the host.
GOOGLE_APPLICATION_CREDENTIALS=""

# ── Frontend build-time API base ────────────────────────────────────────
# Default "/api" works in dev (Vite proxy) AND in the single-service
# deployment above. For a split deployment (static frontend + separate API)
# set the FULL backend origin INCLUDING the /api prefix, e.g.
#   VITE_API_URL="https://sage-api.onrender.com/api"
# (the client appends endpoint paths directly to this value).
VITE_API_URL="/api"

# ── Optional integrations ───────────────────────────────────────────────
# Urgency-scoring ML microservice endpoint.
ML_SERVICE_URL="http://localhost:5001/predict-urgency"
# Escalation email delivery webhook (SendGrid / Postmark / Mailgun / generic).
EMAIL_WEBHOOK_URL=""
SAGE_NO_REPLY_EMAIL="no-reply@campus.edu"
