PORT=5000
NODE_ENV=development

# ---------------------------------------------------------------------------
# SAGE_MASTER_KEY — SERVER-ONLY identity sealing key (REQUIRED in production)
# ---------------------------------------------------------------------------
# The backend AES-encrypts each verified student's Firebase uid with this key
# at submission time (sealing) and decrypts it only inside the gated, audited
# Head Admin reveal flow. This key MUST never be exposed to the browser.
#
# Production: the backend REFUSES to start if this is unset.
# Development: if unset, a clearly-labelled DEV-ONLY fallback key is used so
# the local sandbox/demo keeps working (never for real data).
#
# Generate one locally, e.g.: openssl rand -hex 32
# SAGE_MASTER_KEY=CHANGE_ME_to_a_long_random_secret

# Firebase Admin Configuration (Optional: runs in seamless mock sandbox if omitted)
# FIREBASE_PROJECT_ID=your-firebase-project-id
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account","project_id":"your-firebase-project-id",...}'
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ML Microservice URL (Default: http://localhost:5001/predict-urgency)
ML_SERVICE_URL=http://localhost:5001/predict-urgency
