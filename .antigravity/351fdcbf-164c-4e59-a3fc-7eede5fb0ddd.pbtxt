    replacement_chunks {
      replacement_content: "import { ComplaintCategory, ComplaintStatus } from \'../types\';\n\nexport function formatTimeAgo(isoString: string): string {\n  try {\n    const date = new Date(isoString);\n    const now = new Date();\n    const diffInSeconds = Math.floor((now.getTime() - date.getTime()) / 1000);\n\n    if (diffInSeconds < 60) {\n      return \'Just now\';\n    }\n    const diffInMinutes = Math.floor(diffInSeconds / 60);\n    if (diffInMinutes < 60) {\n      return `${diffInMinutes}m ago`;\n    }\n    const diffInHours = Math.floor(diffInMinutes / 60);\n    if (diffInHours < 24) {\n      return `${diffInHours}h ago`;\n    }\n    const diffInDays = Math.floor(diffInHours / 24);\n    if (diffInDays === 1) {\n      return \'Yesterday\';\n    }\n    if (diffInDays < 7) {\n      return `${diffInDays}d ago`;\n    }\n    return date.toLocaleDateString(\'en-US\', { month: \'short\', day: \'numeric\' });\n  } catch {\n    return \'Recently\';\n  }\n}\n\nexport function getCategoryBadgeStyle(category: ComplaintCategory): {\n  bg: string;\n  text: string;\n  border: string;\n  indicator: string;\n} {\n  switch (category) {\n    case \'Infrastructure\':\n      return {\n        bg: \'bg-stone-100\',\n        text: \'text-[#1C1C1C]\',\n        border: \'border-[#1C1C1C]/30\',\n        indicator: \'bg-[#1C1C1C]\',\n      };\n    case \'Mess/Food\':\n      return {\n        bg: \'bg-amber-50/80\',\n        text: \'text-amber-950\',\n        border: \'border-amber-900/30\',\n        indicator: \'bg-amber-800\',\n      };\n    case \'Harassment\':\n      return {\n        bg: \'bg-red-50\',\n        text: \'text-red-900\',\n        border: \'border-red-800/40\',\n        indicator: \'bg-red-700\',\n      };\n    case \'WiFi/Internet\':\n      return {\n        bg: \'bg-stone-100\',\n        text: \'text-stone-900\',\n        border: \'border-[#1C1C1C]/30\',\n        indicator: \'bg-stone-700\',\n      };\n    case \'Hygiene\':\n      return {\n        bg: \'bg-emerald-50/80\',\n        text: \'text-emerald-950\',\n        border: \'border-emerald-900/30\',\n        indicator: \'bg-emerald-800\',\n      };\n    case \'Other\':\n    default:\n      return {\n        bg: \'bg-stone-50\',\n        text: \'text-stone-800\',\n        border: \'border-stone-400\',\n        indicator: \'bg-stone-600\',\n      };\n  }\n}\n\nexport function getStatusBadgeStyle(status: ComplaintStatus): {\n  bg: string;\n  text: string;\n  border: string;\n  dot: string;\n} {\n  switch (status) {\n    case \'Submitted\':\n      return {\n        bg: \'bg-stone-100\',\n        text: \'text-stone-800\',\n        border: \'border-stone-300\',\n        dot: \'bg-stone-600\',\n      };\n    case \'Under Review\':\n      return {\n        bg: \'bg-amber-100/90\',\n        text: \'text-amber-900\',\n        border: \'border-amber-400\',\n        dot: \'bg-amber-600 animate-pulse\',\n      };\n    case \'Resolved\':\n      return {\n        bg: \'bg-emerald-100/90\',\n        text: \'text-emerald-900\',\n        border: \'border-emerald-400\',\n        dot: \'bg-emerald-700\',\n      };\n  }\n}\n\nexport function generateComplaintId(): string {\n  const randomNum = Math.floor(1000 + Math.random() * 9000);\n  return `SAGE-${randomNum}`;\n}\n"
    }
