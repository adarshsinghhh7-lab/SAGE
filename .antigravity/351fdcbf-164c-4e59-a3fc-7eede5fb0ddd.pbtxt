  user_input {
    user_response: "Here is the full initial file tree for the application:\n/.env.example\n/.gitignore\n/assets/.aistudio/.gitignore\n/index.html\n/metadata.json\n/package.json\n/src/App.tsx\n/src/components/ComplaintCard.tsx\n/src/components/ConfirmationScreen.tsx\n/src/components/ImageModal.tsx\n/src/components/Navbar.tsx\n/src/components/PublicFeed.tsx\n/src/components/SubmissionForm.tsx\n/src/data/initialComplaints.ts\n/src/index.css\n/src/main.tsx\n/src/types.ts\n/src/utils/formatters.ts\n/tsconfig.json\n/vite.config.ts\n\nThe following dependencies are installed:\n@google/genai: ^2.4.0\n@tailwindcss/vite: ^4.1.14\n@vitejs/plugin-react: ^5.0.4\ndotenv: ^17.2.3\nexpress: ^4.21.2\nlucide-react: ^0.546.0\nmotion: ^12.23.24\nreact: ^19.0.1\nreact-dom: ^19.0.1\nvite: ^6.2.3\n\nThe following devDependencies are installed:\n@types/express: ^4.17.21\n@types/node: ^22.14.0\nautoprefixer: ^10.4.21\nesbuild: ^0.25.0\ntailwindcss: ^4.1.14\ntsx: ^4.21.0\ntypescript: ~5.8.2\nvite: ^6.2.3\n\nKey file contents:\n\n--- /.env.example ---\n```\n# GEMINI_API_KEY: Required for Gemini AI API calls.\n# AI Studio automatically injects this at runtime from user secrets.\n# Users configure this via the Secrets panel in the AI Studio UI.\nGEMINI_API_KEY=\"MY_GEMINI_API_KEY\"\n\n# APP_URL: The URL where this applet is hosted.\n# AI Studio automatically injects this at runtime with the Cloud Run service URL.\n# Used for self-referential links, OAuth callbacks, and API endpoints.\nAPP_URL=\"MY_APP_URL\"\n\n```\n\n--- /index.html ---\n```html\n<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>SAGE \302\267 Student Anonymous Grievance & Escalation System</title>\n    <meta name=\"description\" content=\"Student Anonymous Grievance & Escalation System for campus issue reporting and public tracking.\" />\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400..800;1,6..72,400..800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600;700&family=Cinzel:wght@700;900&display=swap\" rel=\"stylesheet\">\n  </head>\n  <body class=\"bg-[#FAF9F6] text-[#1C1C1C] antialiased selection:bg-[#1C1C1C] selection:text-[#FAF9F6] min-h-screen\">\n    <div id=\"root\"></div>\n    <script type=\"module\" src=\"/src/main.tsx\"></script>\n  </body>\n</html>\n\n\n```\n\n--- /metadata.json ---\n```json\n{\n  \"name\": \"SAGE-Student anonymous grievance \\u0026 escalation\",\n  \"description\": \"Student Anonymous Grievance \\u0026 Escalation System prototype featuring anonymous submission and public issue tracking feed.\",\n  \"requestFramePermissions\": [],\n  \"majorCapabilities\": [\n    \"MAJOR_CAPABILITY_SERVER_SIDE_GEMINI_API\"\n  ]\n}\n```\n\n--- /src/App.tsx ---\n```typescript\nimport React, { useState, useEffect } from \'react\';\nimport { Complaint, ComplaintStatus, PageView } from \'./types\';\nimport { INITIAL_COMPLAINTS } from \'./data/initialComplaints\';\nimport { Navbar } from \'./components/Navbar\';\nimport { SubmissionForm } from \'./components/SubmissionForm\';\nimport { ConfirmationScreen } from \'./components/ConfirmationScreen\';\nimport { PublicFeed } from \'./components/PublicFeed\';\nimport { ImageModal } from \'./components/ImageModal\';\n\nconst STORAGE_KEY = \'sage_student_grievances_v1\';\n\nexport default function App() {\n  // Load complaints from localStorage or fallback to seeded dataset\n  const [complaints, setComplaints] = useState<Complaint[]>(() => {\n    try {\n      const saved = localStorage.getItem(STORAGE_KEY);\n      if (saved) {\n        const parsed = JSON.parse(saved);\n        if (Array.isArray(parsed) && parsed.length > 0) {\n          return parsed;\n        }\n      }\n    } catch {\n      // ignore\n    }\n    return INITIAL_COMPLAINTS;\n  });\n\n  const [currentView, setCurrentView] = useState<PageView>(\'feed\');\n  const [latestComplaint, setLatestComplaint] = useState<Complaint | null>(null);\n\n  // Modal for zoomed image inspection\n  const [activeImageModal, setActiveImageModal] = useState<{\n    isOpen: boolean;\n    imageUrl: string | null;\n    title: string;\n  }>({\n    isOpen: false,\n    imageUrl: null,\n    title: \'\',\n  });\n\n  // Sync to localStorage whenever complaints change\n  useEffect(() => {\n    try {\n      localStorage.setItem(STORAGE_KEY, JSON.stringify(complaints));\n    } catch {\n      // ignore localStorage quota errors\n    }\n  }, [complaints]);\n\n  // Handle successful form submission\n  const handleSubmitSuccess = (newComplaint: Complaint) => {\n    setComplaints((prev) => [newComplaint, ...prev]);\n    setLatestComplaint(newComplaint);\n    setCurrentView(\'confirmation\');\n  };\n\n  // Upvote / Toggle Upvote\n  const handleUpvote = (id: string) => {\n    setComplaints((prev) =>\n      prev.map((c) => {\n        if (c.id === id) {\n          const isCurrentlyUpvoted = !!c.hasUpvoted;\n          return {\n            ...c,\n            hasUpvoted: !isCurrentlyUpvoted,\n            upvotes: isCurrentlyUpvoted ? Math.max(0, c.upvotes - 1) : c.upvotes + 1,\n          };\n        }\n        return c;\n      })\n    );\n  };\n\n  // Update status (e.g. for testing lifecycle in prototype)\n  const handleStatusChange = (id: string, newStatus: ComplaintStatus) => {\n    setComplaints((prev) =>\n      prev.map((c) => (c.id === id ? { ...c, status: newStatus } : c))\n    );\n  };\n\n  const handleOpenImage = (imageUrl: string, title: string) => {\n    setActiveImageModal({\n      isOpen: true,\n      imageUrl,\n      title,\n    });\n  };\n\n  const handleCloseImage = () => {\n    setActiveImageModal({\n      isOpen: false,\n      imageUrl: null,\n      title: \'\',\n    });\n  };\n\n  const handleResetToDefaultSeed = () => {\n    setComplaints(INITIAL_COMPLAINTS);\n    localStorage.removeItem(STORAGE_KEY);\n  };\n\n  return (\n    <div className=\"min-h-screen flex flex-col bg-[#FAF9F6] text-[#1C1C1C]\">\n      {/* Header / Navbar */}\n      <Navbar\n        currentView={currentView}\n        onNavigate={(view) => setCurrentView(view)}\n        totalComplaintsCount={complaints.length}\n      />\n\n      {/* Main Content View Switcher */}\n      <main className=\"flex-1\">\n        {currentView === \'submit\' && (\n          <SubmissionForm\n            onSubmitSuccess={handleSubmitSuccess}\n            onCancelToFeed={() => setCurrentView(\'feed\')}\n          />\n        )}\n\n        {currentView === \'confirmation\' && latestComplaint && (\n          <ConfirmationScreen\n            complaint={latestComplaint}\n            onGoToFeed={() => setCurrentView(\'feed\')}\n            onSubmitAnother={() => setCurrentView(\'submit\')}\n          />\n        )}\n\n        {currentView === \'feed\' && (\n          <PublicFeed\n            complaints={complaints}\n            onUpvote={handleUpvote}\n            onOpenImage={handleOpenImage}\n            onStatusChange={handleStatusChange}\n            onGoToSubmit={() => setCurrentView(\'submit\')}\n            onResetToDefaultSeed={handleResetToDefaultSeed}\n          />\n        )}\n      </main>\n\n      {/* Editorial Colophon / Footer */}\n      <footer className=\"border-t-2 border-[#1C1C1C] bg-[#FAF9F6] py-8 px-4 text-center text-xs text-[#1C1C1C]\">\n        <div className=\"max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4\">\n          <p className=\"font-serif italic text-sm text-[#1C1C1C]/80\">\n            <strong>S.A.G.E.</strong> \342\200\224 Student Anonymous Grievance & Escalation System\n          </p>\n          <div className=\"flex items-center gap-4 text-[10px] font-mono uppercase tracking-widest text-[#1C1C1C]/60\">\n            <button\n              type=\"button\"\n              onClick={handleResetToDefaultSeed}\n              className=\"hover:text-red-700 underline cursor-pointer\"\n            >\n              Reset Seed Ledger\n            </button>\n            <span>\302\267</span>\n            <span className=\"text-red-700 font-bold\">100% Cryptographic Anonymity</span>\n          </div>\n        </div>\n      </footer>\n\n      {/* Image Zoom Modal */}\n      {activeImageModal.isOpen && (\n        <ImageModal\n          imageUrl={activeImageModal.imageUrl}\n          title={activeImageModal.title}\n          onClose={handleCloseImage}\n        />\n      )}\n    </div>\n  );\n}\n\n```\n\n--- /src/index.css ---\n```css\n@import \"tailwindcss\";\n\n@layer base {\n  body {\n    font-family: \'Plus Jakarta Sans\', -apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, sans-serif;\n    background-color: #FAF9F6;\n    color: #1C1C1C;\n  }\n\n  h1, h2, h3, .font-serif-editorial {\n    font-family: \'Newsreader\', Georgia, Cambria, \'Times New Roman\', Times, serif;\n  }\n\n  code, kbd, samp, pre, .font-mono-editorial {\n    font-family: \'JetBrains Mono\', monospace;\n  }\n}\n\n.editorial-masthead-title {\n  font-family: \'Newsreader\', Georgia, serif;\n  letter-spacing: -0.02em;\n}\n\n.editorial-rule {\n  height: 1px;\n  background-color: rgba(28, 28, 28, 0.15);\n}\n\n.editorial-rule-dark {\n  height: 2px;\n  background-color: #1C1C1C;\n}\n\n.editorial-accent-line {\n  height: 2px;\n  width: 3rem;\n  background-color: #b91c1c;\n}\n\n\n```\n\n--- /src/main.tsx ---\n```typescript\nimport {StrictMode} from \'react\';\nimport {createRoot} from \'react-dom/client\';\nimport App from \'./App.tsx\';\nimport \'./index.css\';\n\ncreateRoot(document.getElementById(\'root\')!).render(\n  <StrictMode>\n    <App />\n  </StrictMode>,\n);\n\n```\n\n--- /tsconfig.json ---\n```json\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"experimentalDecorators\": true,\n    \"useDefineForClassFields\": false,\n    \"module\": \"ESNext\",\n    \"lib\": [\n      \"ES2022\",\n      \"DOM\",\n      \"DOM.Iterable\"\n    ],\n    \"skipLibCheck\": true,\n    \"moduleResolution\": \"bundler\",\n    \"isolatedModules\": true,\n    \"moduleDetection\": \"force\",\n    \"allowJs\": true,\n    \"jsx\": \"react-jsx\",\n    \"paths\": {\n      \"@/*\": [\n        \"./*\"\n      ]\n    },\n    \"allowImportingTsExtensions\": true,\n    \"noEmit\": true\n  }\n}\n\n```\n\n--- /vite.config.ts ---\n```typescript\nimport tailwindcss from \'@tailwindcss/vite\';\nimport react from \'@vitejs/plugin-react\';\nimport path from \'path\';\nimport {defineConfig} from \'vite\';\n\nexport default defineConfig(() => {\n  return {\n    plugins: [react(), tailwindcss()],\n    resolve: {\n      alias: {\n        \'@\': path.resolve(__dirname, \'.\'),\n      },\n    },\n    server: {\n      // HMR is disabled in AI Studio via DISABLE_HMR env var.\n      // Do not modify\303\242\302\200\302\224file watching is disabled to prevent flickering during agent edits.\n      hmr: process.env.DISABLE_HMR !== \'true\',\n      // Disable file watching when DISABLE_HMR is true to save CPU during agent edits.\n      watch: process.env.DISABLE_HMR === \'true\' ? null : {},\n    },\n  };\n});\n\n```"
    items {
      text: "Here is the full initial file tree for the application:\n/.env.example\n/.gitignore\n/assets/.aistudio/.gitignore\n/index.html\n/metadata.json\n/package.json\n/src/App.tsx\n/src/components/ComplaintCard.tsx\n/src/components/ConfirmationScreen.tsx\n/src/components/ImageModal.tsx\n/src/components/Navbar.tsx\n/src/components/PublicFeed.tsx\n/src/components/SubmissionForm.tsx\n/src/data/initialComplaints.ts\n/src/index.css\n/src/main.tsx\n/src/types.ts\n/src/utils/formatters.ts\n/tsconfig.json\n/vite.config.ts\n\nThe following dependencies are installed:\n@google/genai: ^2.4.0\n@tailwindcss/vite: ^4.1.14\n@vitejs/plugin-react: ^5.0.4\ndotenv: ^17.2.3\nexpress: ^4.21.2\nlucide-react: ^0.546.0\nmotion: ^12.23.24\nreact: ^19.0.1\nreact-dom: ^19.0.1\nvite: ^6.2.3\n\nThe following devDependencies are installed:\n@types/express: ^4.17.21\n@types/node: ^22.14.0\nautoprefixer: ^10.4.21\nesbuild: ^0.25.0\ntailwindcss: ^4.1.14\ntsx: ^4.21.0\ntypescript: ~5.8.2\nvite: ^6.2.3\n\nKey file contents:\n\n--- /.env.example ---\n```\n# GEMINI_API_KEY: Required for Gemini AI API calls.\n# AI Studio automatically injects this at runtime from user secrets.\n# Users configure this via the Secrets panel in the AI Studio UI.\nGEMINI_API_KEY=\"MY_GEMINI_API_KEY\"\n\n# APP_URL: The URL where this applet is hosted.\n# AI Studio automatically injects this at runtime with the Cloud Run service URL.\n# Used for self-referential links, OAuth callbacks, and API endpoints.\nAPP_URL=\"MY_APP_URL\"\n\n```\n\n--- /index.html ---\n```html\n<!doctype html>\n<html lang=\"en\">\n  <head>\n    <meta charset=\"UTF-8\" />\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\" />\n    <title>SAGE \302\267 Student Anonymous Grievance & Escalation System</title>\n    <meta name=\"description\" content=\"Student Anonymous Grievance & Escalation System for campus issue reporting and public tracking.\" />\n    <link rel=\"preconnect\" href=\"https://fonts.googleapis.com\">\n    <link rel=\"preconnect\" href=\"https://fonts.gstatic.com\" crossorigin>\n    <link href=\"https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400..800;1,6..72,400..800&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600;700&family=Cinzel:wght@700;900&display=swap\" rel=\"stylesheet\">\n  </head>\n  <body class=\"bg-[#FAF9F6] text-[#1C1C1C] antialiased selection:bg-[#1C1C1C] selection:text-[#FAF9F6] min-h-screen\">\n    <div id=\"root\"></div>\n    <script type=\"module\" src=\"/src/main.tsx\"></script>\n  </body>\n</html>\n\n\n```\n\n--- /metadata.json ---\n```json\n{\n  \"name\": \"SAGE-Student anonymous grievance \\u0026 escalation\",\n  \"description\": \"Student Anonymous Grievance \\u0026 Escalation System prototype featuring anonymous submission and public issue tracking feed.\",\n  \"requestFramePermissions\": [],\n  \"majorCapabilities\": [\n    \"MAJOR_CAPABILITY_SERVER_SIDE_GEMINI_API\"\n  ]\n}\n```\n\n--- /src/App.tsx ---\n```typescript\nimport React, { useState, useEffect } from \'react\';\nimport { Complaint, ComplaintStatus, PageView } from \'./types\';\nimport { INITIAL_COMPLAINTS } from \'./data/initialComplaints\';\nimport { Navbar } from \'./components/Navbar\';\nimport { SubmissionForm } from \'./components/SubmissionForm\';\nimport { ConfirmationScreen } from \'./components/ConfirmationScreen\';\nimport { PublicFeed } from \'./components/PublicFeed\';\nimport { ImageModal } from \'./components/ImageModal\';\n\nconst STORAGE_KEY = \'sage_student_grievances_v1\';\n\nexport default function App() {\n  // Load complaints from localStorage or fallback to seeded dataset\n  const [complaints, setComplaints] = useState<Complaint[]>(() => {\n    try {\n      const saved = localStorage.getItem(STORAGE_KEY);\n      if (saved) {\n        const parsed = JSON.parse(saved);\n        if (Array.isArray(parsed) && parsed.length > 0) {\n          return parsed;\n        }\n      }\n    } catch {\n      // ignore\n    }\n    return INITIAL_COMPLAINTS;\n  });\n\n  const [currentView, setCurrentView] = useState<PageView>(\'feed\');\n  const [latestComplaint, setLatestComplaint] = useState<Complaint | null>(null);\n\n  // Modal for zoomed image inspection\n  const [activeImageModal, setActiveImageModal] = useState<{\n    isOpen: boolean;\n    imageUrl: string | null;\n    title: string;\n  }>({\n    isOpen: false,\n    imageUrl: null,\n    title: \'\',\n  });\n\n  // Sync to localStorage whenever complaints change\n  useEffect(() => {\n    try {\n      localStorage.setItem(STORAGE_KEY, JSON.stringify(complaints));\n    } catch {\n      // ignore localStorage quota errors\n    }\n  }, [complaints]);\n\n  // Handle successful form submission\n  const handleSubmitSuccess = (newComplaint: Complaint) => {\n    setComplaints((prev) => [newComplaint, ...prev]);\n    setLatestComplaint(newComplaint);\n    setCurrentView(\'confirmation\');\n  };\n\n  // Upvote / Toggle Upvote\n  const handleUpvote = (id: string) => {\n    setComplaints((prev) =>\n      prev.map((c) => {\n        if (c.id === id) {\n          const isCurrentlyUpvoted = !!c.hasUpvoted;\n          return {\n            ...c,\n            hasUpvoted: !isCurrentlyUpvoted,\n            upvotes: isCurrentlyUpvoted ? Math.max(0, c.upvotes - 1) : c.upvotes + 1,\n          };\n        }\n        return c;\n      })\n    );\n  };\n\n  // Update status (e.g. for testing lifecycle in prototype)\n  const handleStatusChange = (id: string, newStatus: ComplaintStatus) => {\n    setComplaints((prev) =>\n      prev.map((c) => (c.id === id ? { ...c, status: newStatus } : c))\n    );\n  };\n\n  const handleOpenImage = (imageUrl: string, title: string) => {\n    setActiveImageModal({\n      isOpen: true,\n      imageUrl,\n      title,\n    });\n  };\n\n  const handleCloseImage = () => {\n    setActiveImageModal({\n      isOpen: false,\n      imageUrl: null,\n      title: \'\',\n    });\n  };\n\n  const handleResetToDefaultSeed = () => {\n    setComplaints(INITIAL_COMPLAINTS);\n    localStorage.removeItem(STORAGE_KEY);\n  };\n\n  return (\n    <div className=\"min-h-screen flex flex-col bg-[#FAF9F6] text-[#1C1C1C]\">\n      {/* Header / Navbar */}\n      <Navbar\n        currentView={currentView}\n        onNavigate={(view) => setCurrentView(view)}\n        totalComplaintsCount={complaints.length}\n      />\n\n      {/* Main Content View Switcher */}\n      <main className=\"flex-1\">\n        {currentView === \'submit\' && (\n          <SubmissionForm\n            onSubmitSuccess={handleSubmitSuccess}\n            onCancelToFeed={() => setCurrentView(\'feed\')}\n          />\n        )}\n\n        {currentView === \'confirmation\' && latestComplaint && (\n          <ConfirmationScreen\n            complaint={latestComplaint}\n            onGoToFeed={() => setCurrentView(\'feed\')}\n            onSubmitAnother={() => setCurrentView(\'submit\')}\n          />\n        )}\n\n        {currentView === \'feed\' && (\n          <PublicFeed\n            complaints={complaints}\n            onUpvote={handleUpvote}\n            onOpenImage={handleOpenImage}\n            onStatusChange={handleStatusChange}\n            onGoToSubmit={() => setCurrentView(\'submit\')}\n            onResetToDefaultSeed={handleResetToDefaultSeed}\n          />\n        )}\n      </main>\n\n      {/* Editorial Colophon / Footer */}\n      <footer className=\"border-t-2 border-[#1C1C1C] bg-[#FAF9F6] py-8 px-4 text-center text-xs text-[#1C1C1C]\">\n        <div className=\"max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4\">\n          <p className=\"font-serif italic text-sm text-[#1C1C1C]/80\">\n            <strong>S.A.G.E.</strong> \342\200\224 Student Anonymous Grievance & Escalation System\n          </p>\n          <div className=\"flex items-center gap-4 text-[10px] font-mono uppercase tracking-widest text-[#1C1C1C]/60\">\n            <button\n              type=\"button\"\n              onClick={handleResetToDefaultSeed}\n              className=\"hover:text-red-700 underline cursor-pointer\"\n            >\n              Reset Seed Ledger\n            </button>\n            <span>\302\267</span>\n            <span className=\"text-red-700 font-bold\">100% Cryptographic Anonymity</span>\n          </div>\n        </div>\n      </footer>\n\n      {/* Image Zoom Modal */}\n      {activeImageModal.isOpen && (\n        <ImageModal\n          imageUrl={activeImageModal.imageUrl}\n          title={activeImageModal.title}\n          onClose={handleCloseImage}\n        />\n      )}\n    </div>\n  );\n}\n\n```\n\n--- /src/index.css ---\n```css\n@import \"tailwindcss\";\n\n@layer base {\n  body {\n    font-family: \'Plus Jakarta Sans\', -apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, sans-serif;\n    background-color: #FAF9F6;\n    color: #1C1C1C;\n  }\n\n  h1, h2, h3, .font-serif-editorial {\n    font-family: \'Newsreader\', Georgia, Cambria, \'Times New Roman\', Times, serif;\n  }\n\n  code, kbd, samp, pre, .font-mono-editorial {\n    font-family: \'JetBrains Mono\', monospace;\n  }\n}\n\n.editorial-masthead-title {\n  font-family: \'Newsreader\', Georgia, serif;\n  letter-spacing: -0.02em;\n}\n\n.editorial-rule {\n  height: 1px;\n  background-color: rgba(28, 28, 28, 0.15);\n}\n\n.editorial-rule-dark {\n  height: 2px;\n  background-color: #1C1C1C;\n}\n\n.editorial-accent-line {\n  height: 2px;\n  width: 3rem;\n  background-color: #b91c1c;\n}\n\n\n```\n\n--- /src/main.tsx ---\n```typescript\nimport {StrictMode} from \'react\';\nimport {createRoot} from \'react-dom/client\';\nimport App from \'./App.tsx\';\nimport \'./index.css\';\n\ncreateRoot(document.getElementById(\'root\')!).render(\n  <StrictMode>\n    <App />\n  </StrictMode>,\n);\n\n```\n\n--- /tsconfig.json ---\n```json\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"experimentalDecorators\": true,\n    \"useDefineForClassFields\": false,\n    \"module\": \"ESNext\",\n    \"lib\": [\n      \"ES2022\",\n      \"DOM\",\n      \"DOM.Iterable\"\n    ],\n    \"skipLibCheck\": true,\n    \"moduleResolution\": \"bundler\",\n    \"isolatedModules\": true,\n    \"moduleDetection\": \"force\",\n    \"allowJs\": true,\n    \"jsx\": \"react-jsx\",\n    \"paths\": {\n      \"@/*\": [\n        \"./*\"\n      ]\n    },\n    \"allowImportingTsExtensions\": true,\n    \"noEmit\": true\n  }\n}\n\n```\n\n--- /vite.config.ts ---\n```typescript\nimport tailwindcss from \'@tailwindcss/vite\';\nimport react from \'@vitejs/plugin-react\';\nimport path from \'path\';\nimport {defineConfig} from \'vite\';\n\nexport default defineConfig(() => {\n  return {\n    plugins: [react(), tailwindcss()],\n    resolve: {\n      alias: {\n        \'@\': path.resolve(__dirname, \'.\'),\n      },\n    },\n    server: {\n      // HMR is disabled in AI Studio via DISABLE_HMR env var.\n      // Do not modify\303\242\302\200\302\224file watching is disabled to prevent flickering during agent edits.\n      hmr: process.env.DISABLE_HMR !== \'true\',\n      // Disable file watching when DISABLE_HMR is true to save CPU during agent edits.\n      watch: process.env.DISABLE_HMR === \'true\' ? null : {},\n    },\n  };\n});\n\n```"
