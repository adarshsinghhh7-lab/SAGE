      replacement_content: "import React, { useState } from \'react\';\nimport { \n  ArrowBigUp, \n  MapPin, \n  Clock, \n  ChevronDown, \n  ChevronUp, \n  Image as ImageIcon,\n  CheckCircle2, \n  Lock,\n  ExternalLink\n} from \'lucide-react\';\nimport { Complaint, ComplaintStatus } from \'../types\';\nimport { getCategoryBadgeStyle, getStatusBadgeStyle, formatTimeAgo } from \'../utils/formatters\';\n\ninterface ComplaintCardProps {\n  complaint: Complaint;\n  onUpvote: (id: string) => void;\n  onOpenImage: (imageUrl: string, title: string) => void;\n  onStatusChange: (id: string, newStatus: ComplaintStatus) => void;\n}\n\nexport const ComplaintCard: React.FC<ComplaintCardProps> = ({\n  complaint,\n  onUpvote,\n  onOpenImage,\n  onStatusChange,\n}) => {\n  const [isExpanded, setIsExpanded] = useState<boolean>(false);\n  const [showStatusMenu, setShowStatusMenu] = useState<boolean>(false);\n\n  const catStyle = getCategoryBadgeStyle(complaint.category);\n  const statusStyle = getStatusBadgeStyle(complaint.status);\n\n  const isLongDescription = complaint.description.length > 180;\n  const displayDescription = !isExpanded && isLongDescription\n    ? `${complaint.description.slice(0, 180)}...`\n    : complaint.description;\n\n  return (\n    <article\n      id={`complaint-card-${complaint.id}`}\n      className=\"bg-white border border-slate-200/90 rounded-2xl p-5 sm:p-6 transition-all hover:shadow-md hover:border-blue-200 flex flex-col justify-between\"\n    >\n      <div>\n        {/* Top Header Row */}\n        <div className=\"flex flex-wrap items-center justify-between gap-2.5 mb-3\">\n          <div className=\"flex items-center gap-2 flex-wrap\">\n            {/* Complaint ID */}\n            <span className=\"font-mono font-bold text-xs bg-slate-100 text-slate-800 border border-slate-200 px-2.5 py-1 rounded-lg tracking-wide select-all\">\n              {complaint.id}\n            </span>\n\n            {/* Category Badge */}\n            <span className={`inline-flex items-center gap-1.5 text-xs font-semibold px-2.5 py-0.5 rounded-full border ${catStyle.bg} ${catStyle.text} ${catStyle.border}`}>\n              <span className={`w-1.5 h-1.5 rounded-full ${catStyle.indicator}`} />\n              {complaint.category}\n            </span>\n\n            {/* High priority flag if harassment / urgent */}\n            {complaint.urgency === \'Urgent\' && (\n              <span className=\"text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 bg-rose-50 text-rose-700 border border-rose-200 rounded-md\">\n                High Priority\n              </span>\n            )}\n          </div>\n\n          {/* Status Badge + Lifecycle Menu */}\n          <div className=\"relative\">\n            <button\n              type=\"button\"\n              onClick={() => setShowStatusMenu(!showStatusMenu)}\n              title=\"Click to update status for demo testing\"\n              className={`inline-flex items-center gap-1.5 px-3 py-1 text-xs font-medium rounded-full border transition-all cursor-pointer ${statusStyle.bg} ${statusStyle.text} ${statusStyle.border} hover:opacity-90`}\n            >\n              <span className={`w-1.5 h-1.5 rounded-full ${statusStyle.dot}`} />\n              <span>{complaint.status}</span>\n              <ChevronDown className=\"w-3 h-3 opacity-60 ml-0.5\" />\n            </button>\n\n            {/* Status Dropdown Menu */}\n            {showStatusMenu && (\n              <div className=\"absolute right-0 mt-1.5 w-44 bg-white border border-slate-200 rounded-xl shadow-lg z-20 py-1 text-xs\">\n                <div className=\"px-3 py-1.5 text-[10px] font-semibold uppercase tracking-wider text-slate-400 border-b border-slate-100\">\n                  Update Status\n                </div>\n                {([\'Submitted\', \'Under Review\', \'Resolved\'] as ComplaintStatus[]).map((st) => (\n                  <button\n                    key={st}\n                    type=\"button\"\n                    onClick={() => {\n                      onStatusChange(complaint.id, st);\n                      setShowStatusMenu(false);\n                    }}\n                    className={`w-full text-left px-3 py-2 flex items-center justify-between hover:bg-slate-50 cursor-pointer ${\n                      complaint.status === st ? \'font-semibold text-blue-700 bg-blue-50/50\' : \'text-slate-700\'\n                    }`}\n                  >\n                    <span>{st}</span>\n                    {complaint.status === st && <CheckCircle2 className=\"w-3.5 h-3.5 text-blue-600\" />}\n                  </button>\n                ))}\n              </div>\n            )}\n          </div>\n        </div>\n\n        {/* Location & Time Info */}\n        <div className=\"flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-slate-500 mb-3.5\">\n          <div className=\"flex items-center gap-1.5 font-medium text-slate-700\">\n            <MapPin className=\"w-3.5 h-3.5 text-blue-600 shrink-0\" />\n            <span className=\"truncate max-w-[260px]\">{complaint.location}</span>\n          </div>\n\n          <div className=\"flex items-center gap-1 text-slate-400\">\n            <Clock className=\"w-3.5 h-3.5 shrink-0\" />\n            <span>{formatTimeAgo(complaint.createdAt)}</span>\n          </div>\n\n          <div className=\"flex items-center gap-1 text-slate-500\">\n            <Lock className=\"w-3 h-3 text-blue-600 shrink-0\" />\n            <span className=\"text-[11px]\">Anonymous</span>\n          </div>\n        </div>\n\n        {/* Description Body */}\n        <div className=\"text-sm text-slate-700 leading-relaxed mb-4\">\n          <p className=\"whitespace-pre-line\">{displayDescription}</p>\n          {isLongDescription && (\n            <button\n              type=\"button\"\n              onClick={() => setIsExpanded(!isExpanded)}\n              className=\"inline-flex items-center gap-1 text-xs font-semibold text-blue-600 hover:text-blue-700 mt-2 cursor-pointer\"\n            >\n              {isExpanded ? (\n                <>\n                  <span>Show Less</span>\n                  <ChevronUp className=\"w-3.5 h-3.5\" />\n                </>\n              ) : (\n                <>\n                  <span>Read Full Description</span>\n                  <ChevronDown className=\"w-3.5 h-3.5\" />\n                </>\n              )}\n            </button>\n          )}\n        </div>\n\n        {/* Photo Evidence Preview */}\n        {complaint.photoUrl && (\n          <div className=\"mb-4\">\n            <button\n              type=\"button\"\n              onClick={() => onOpenImage(complaint.photoUrl!, `${complaint.id} - ${complaint.category}`)}\n              className=\"group inline-flex items-center gap-2.5 p-1.5 pr-3 bg-slate-50 hover:bg-blue-50 border border-slate-200 hover:border-blue-300 rounded-xl transition-all text-xs font-medium text-slate-700 cursor-pointer\"\n            >\n              <img\n                src={complaint.photoUrl}\n                alt=\"Grievance Evidence\"\n                className=\"w-11 h-11 rounded-lg object-cover border border-slate-200 shrink-0 bg-white\"\n                referrerPolicy=\"no-referrer\"\n              />\n              <div className=\"text-left\">\n                <div className=\"flex items-center gap-1 font-semibold text-slate-800\">\n                  <ImageIcon className=\"w-3.5 h-3.5 text-blue-600\" />\n                  <span>Evidence Photo</span>\n                </div>\n                <span className=\"text-[11px] text-slate-400 flex items-center gap-0.5\">\n                  Click to inspect <ExternalLink className=\"w-2.5 h-2.5 ml-0.5 opacity-60\" />\n                </span>\n              </div>\n            </button>\n          </div>\n        )}\n      </div>\n\n      {/* Bottom Footer: Upvote Button & Velocity */}\n      <div className=\"pt-3.5 border-t border-slate-100 flex items-center justify-between gap-3 mt-2\">\n        <button\n          id={`upvote-btn-${complaint.id}`}\n          type=\"button\"\n          onClick={() => onUpvote(complaint.id)}\n          className={`inline-flex items-center gap-2 px-3.5 py-1.5 text-xs font-semibold rounded-xl border transition-all cursor-pointer ${\n            complaint.hasUpvoted\n              ? \'bg-blue-600 text-white border-blue-600 shadow-xs\'\n              : \'bg-white text-slate-700 border-slate-200 hover:bg-blue-50 hover:border-blue-300 hover:text-blue-700\'\n          }`}\n          title=\"Upvote this complaint to raise visibility\"\n        >\n          <ArrowBigUp className={`w-4 h-4 stroke-[2.2] transition-transform ${complaint.hasUpvoted ? \'fill-current scale-110\' : \'\'}`} />\n          <span className=\"font-mono text-xs\">{complaint.upvotes}</span>\n          <span className=\"text-[11px] font-medium hidden sm:inline\">\n            {complaint.hasUpvoted ? \'Upvoted\' : \'Upvote\'}\n          </span>\n        </button>\n\n        <div className=\"text-[11px] text-slate-400 font-medium flex items-center gap-1.5\">\n          <span>Priority Weight:</span>\n          <span className=\"font-semibold text-slate-700\">\n            {complaint.upvotes > 50 ? \'High\' : complaint.upvotes > 20 ? \'Elevated\' : \'Standard\'}\n          </span>\n        </div>\n      </div>\n    </article>\n  );\n};\n"
    }
