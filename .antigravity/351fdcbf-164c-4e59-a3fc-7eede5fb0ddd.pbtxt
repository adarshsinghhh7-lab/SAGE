  file_change {
    absolute_path_uri: "file:///src/components/ComplaintCard.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { \n  ArrowBigUp, \n  MapPin, \n  Clock, \n  ChevronDown, \n  ChevronUp, \n  Image as ImageIcon,\n  CheckCircle2, \n  Lock,\n  ExternalLink,\n  ShieldAlert\n} from \'lucide-react\';\nimport { Complaint, ComplaintStatus } from \'../types\';\nimport { getCategoryBadgeStyle, getStatusBadgeStyle, formatTimeAgo } from \'../utils/formatters\';\n\ninterface ComplaintCardProps {\n  complaint: Complaint;\n  onUpvote: (id: string) => void;\n  onOpenImage: (imageUrl: string, title: string) => void;\n  onStatusChange: (id: string, newStatus: ComplaintStatus) => void;\n}\n\nexport const ComplaintCard: React.FC<ComplaintCardProps> = ({\n  complaint,\n  onUpvote,\n  onOpenImage,\n  onStatusChange,\n}) => {\n  const [isExpanded, setIsExpanded] = useState<boolean>(false);\n  const [showStatusMenu, setShowStatusMenu] = useState<boolean>(false);\n\n  const catStyle = getCategoryBadgeStyle(complaint.category);\n  const statusStyle = getStatusBadgeStyle(complaint.status);\n\n  const isLongDescription = complaint.description.length > 180;\n  const displayDescription = !isExpanded && isLongDescription\n    ? `${complaint.description.slice(0, 180)}...`\n    : complaint.description;\n\n  return (\n    <article\n      id={`complaint-card-${complaint.id}`}\n      className=\"bg-[#FAF9F6] border-2 border-[#1C1C1C] p-5 sm:p-6 transition-all shadow-[4px_4px_0px_0px_#1C1C1C] hover:translate-x-[-1px] hover:translate-y-[-1px] hover:shadow-[5px_5px_0px_0px_#1C1C1C] flex flex-col justify-between\"\n    >\n      <div>\n        {/* Top Header Row */}\n        <div className=\"flex flex-wrap items-center justify-between gap-2.5 mb-3\">\n          <div className=\"flex items-center gap-2 flex-wrap\">\n            {/* Complaint ID */}\n            <span className=\"font-mono font-bold text-xs bg-[#1C1C1C] text-[#FAF9F6] px-2 py-0.5 tracking-wider select-all\">\n              {complaint.id}\n            </span>\n\n            {/* Category Badge */}\n            <span className={`inline-flex items-center gap-1.5 text-[11px] font-mono font-bold uppercase px-2 py-0.5 border ${catStyle.bg} ${catStyle.text} ${catStyle.border}`}>\n              <span className={`w-1.5 h-1.5 rounded-full ${catStyle.indicator}`} />\n              {complaint.category}\n            </span>\n\n            {/* High priority flag if harassment / urgent */}\n            {complaint.urgency === \'Urgent\' && (\n              <span className=\"text-[10px] font-mono font-bold uppercase px-1.5 py-0.5 bg-red-700 text-white\">\n                Urgent Priority\n              </span>\n            )}\n          </div>\n\n          {/* Status Badge + Lifecycle Menu */}\n          <div className=\"relative\">\n            <button\n              type=\"button\"\n              onClick={() => setShowStatusMenu(!showStatusMenu)}\n              title=\"Click to update status for demo testing\"\n              className={`inline-flex items-center gap-1.5 px-2.5 py-0.5 text-[11px] font-mono font-bold uppercase border cursor-pointer ${statusStyle.bg} ${statusStyle.text} ${statusStyle.border}`}\n            >\n              <span className={`w-1.5 h-1.5 rounded-full ${statusStyle.dot}`} />\n              <span>{complaint.status}</span>\n              <ChevronDown className=\"w-3 h-3 opacity-60 ml-0.5\" />\n            </button>\n\n            {/* Status Dropdown Menu */}\n            {showStatusMenu && (\n              <div className=\"absolute right-0 mt-1 w-44 bg-[#FAF9F6] border-2 border-[#1C1C1C] shadow-[3px_3px_0px_0px_#1C1C1C] z-20 py-1 text-xs font-mono\">\n                <div className=\"px-3 py-1 text-[9px] font-bold uppercase tracking-wider text-[#1C1C1C]/60 border-b border-[#1C1C1C]/20\">\n                  Update Ledger Status\n                </div>\n                {([\'Submitted\', \'Under Review\', \'Resolved\'] as ComplaintStatus[]).map((st) => (\n                  <button\n                    key={st}\n                    type=\"button\"\n                    onClick={() => {\n                      onStatusChange(complaint.id, st);\n                      setShowStatusMenu(false);\n                    }}\n                    className={`w-full text-left px-3 py-1.5 flex items-center justify-between hover:bg-stone-200 cursor-pointer ${\n                      complaint.status === st ? \'font-bold bg-stone-200/80 text-red-700\' : \'text-[#1C1C1C]\'\n                    }`}\n                  >\n                    <span>{st}</span>\n                    {complaint.status === st && <CheckCircle2 className=\"w-3.5 h-3.5 text-red-700\" />}\n                  </button>\n                ))}\n              </div>\n            )}\n          </div>\n        </div>\n\n        {/* Location & Time Info */}\n        <div className=\"flex flex-wrap items-center gap-x-3 gap-y-1 text-xs font-mono text-[#1C1C1C]/70 mb-3\">\n          <div className=\"flex items-center gap-1 font-bold text-[#1C1C1C]\">\n            <MapPin className=\"w-3 h-3 text-red-700 shrink-0\" />\n            <span className=\"truncate max-w-[260px]\">{complaint.location}</span>\n          </div>\n\n          <div className=\"flex items-center gap-1 text-[#1C1C1C]/50\">\n            <span>\302\267</span>\n            <Clock className=\"w-3 h-3 shrink-0\" />\n            <span>{formatTimeAgo(complaint.createdAt)}</span>\n          </div>\n\n          <div className=\"flex items-center gap-1 text-red-700\">\n            <span>\302\267</span>\n            <Lock className=\"w-2.5 h-2.5 shrink-0\" />\n            <span className=\"text-[10px] uppercase font-bold\">Anonymous</span>\n          </div>\n        </div>\n\n        {/* Description Body */}\n        <div className=\"text-sm font-serif text-[#1C1C1C] leading-relaxed mb-4\">\n          <p className=\"whitespace-pre-line\">{displayDescription}</p>\n          {isLongDescription && (\n            <button\n              type=\"button\"\n              onClick={() => setIsExpanded(!isExpanded)}\n              className=\"inline-flex items-center gap-1 text-xs font-mono font-bold uppercase text-red-700 hover:underline mt-2 cursor-pointer\"\n            >\n              {isExpanded ? (\n                <>\n                  <span>[-] Collapse Statement</span>\n                </>\n              ) : (\n                <>\n                  <span>[+] Read Full Statement</span>\n                </>\n              )}\n            </button>\n          )}\n        </div>\n\n        {/* Photo Evidence Preview */}\n        {complaint.photoUrl && (\n          <div className=\"mb-4\">\n            <button\n              type=\"button\"\n              onClick={() => onOpenImage(complaint.photoUrl!, `${complaint.id} - ${complaint.category}`)}\n              className=\"inline-flex items-center gap-2.5 p-1.5 pr-3 bg-stone-100 hover:bg-stone-200 border border-[#1C1C1C]/40 transition-all text-xs font-mono text-[#1C1C1C] cursor-pointer\"\n            >\n              <img\n                src={complaint.photoUrl}\n                alt=\"Deposition Evidence\"\n                className=\"w-10 h-10 object-cover border border-[#1C1C1C] shrink-0 bg-white\"\n                referrerPolicy=\"no-referrer\"\n              />\n              <div className=\"text-left\">\n                <div className=\"flex items-center gap-1 font-bold text-[#1C1C1C]\">\n                  <ImageIcon className=\"w-3.5 h-3.5 text-red-700\" />\n                  <span>Evidence Attachment</span>\n                </div>\n                <span className=\"text-[10px] text-[#1C1C1C]/60 flex items-center gap-0.5\">\n                  Click to inspect <ExternalLink className=\"w-2.5 h-2.5 ml-0.5 opacity-60\" />\n                </span>\n              </div>\n            </button>\n          </div>\n        )}\n      </div>\n\n      {/* Bottom Footer: Upvote Button & Priority */}\n      <div className=\"pt-3 border-t border-[#1C1C1C]/20 flex items-center justify-between gap-3 mt-2\">\n        <button\n          id={`upvote-btn-${complaint.id}`}\n          type=\"button\"\n          onClick={() => onUpvote(complaint.id)}\n          className={`inline-flex items-center gap-2 px-3 py-1.5 text-xs font-mono font-bold uppercase tracking-wider border-2 border-[#1C1C1C] transition-all cursor-pointer ${\n            complaint.hasUpvoted\n              ? \'bg-red-700 text-white border-red-700 shadow-[2px_2px_0px_0px_#1C1C1C]\'\n              : \'bg-white text-[#1C1C1C] hover:bg-stone-200 shadow-[2px_2px_0px_0px_#1C1C1C]\'\n          }`}\n          title=\"Endorse this grievance to raise urgency\"\n        >\n          <ArrowBigUp className={`w-4 h-4 stroke-[2.2] ${complaint.hasUpvoted ? \'fill-current\' : \'\'}`} />\n          <span>{complaint.upvotes}</span>\n          <span className=\"text-[10px] hidden sm:inline\">\n            {complaint.hasUpvoted ? \'Endorsed\' : \'Endorse\'}\n          </span>\n        </button>\n\n        <div className=\"text-[10px] font-mono uppercase text-[#1C1C1C]/60 flex items-center gap-1.5\">\n          <span>Priority Weight:</span>\n          <span className=\"font-bold text-[#1C1C1C]\">\n            {complaint.upvotes > 50 ? \'Critical\' : complaint.upvotes > 20 ? \'Elevated\' : \'Standard\'}\n          </span>\n        </div>\n      </div>\n    </article>\n  );\n};\n"
    }
    diff {
      end_line: 207
