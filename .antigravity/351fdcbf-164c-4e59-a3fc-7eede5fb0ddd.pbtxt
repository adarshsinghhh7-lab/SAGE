  file_change {
    absolute_path_uri: "file:///src/components/PublicFeed.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useMemo } from \'react\';\nimport { \n  Search, \n  Filter, \n  ArrowUpDown, \n  PlusCircle, \n  RotateCcw, \n  Inbox,\n  Lock,\n  Building2,\n  Tag,\n  Activity,\n  Sparkles\n} from \'lucide-react\';\nimport { Complaint, ComplaintCategory, ComplaintStatus } from \'../types\';\nimport { ComplaintCard } from \'./ComplaintCard\';\n\ninterface PublicFeedProps {\n  complaints: Complaint[];\n  onUpvote: (id: string) => void;\n  onSelectComplaint: (complaint: Complaint) => void;\n  onOpenImage?: (imageUrl: string, title: string) => void;\n  onGoToSubmit: () => void;\n  onResetToDefaultSeed?: () => void;\n}\n\nconst CATEGORIES: ComplaintCategory[] = [\n  \'Infrastructure\',\n  \'Mess/Food\',\n  \'Harassment\',\n  \'WiFi/Internet\',\n  \'Hygiene\',\n  \'Other\'\n];\n\nconst STATUS_FILTER_OPTIONS = [\n  \'All\',\n  \'Under Review\',\n  \'Resolved\',\n  \'High Priority\',\n  \'Submitted\'\n];\n\nexport const PublicFeed: React.FC<PublicFeedProps> = ({\n  complaints,\n  onUpvote,\n  onSelectComplaint,\n  onOpenImage,\n  onGoToSubmit,\n  onResetToDefaultSeed,\n}) => {\n  const [searchQuery, setSearchQuery] = useState<string>(\'\');\n  const [selectedCategory, setSelectedCategory] = useState<string>(\'All\');\n  const [selectedLocation, setSelectedLocation] = useState<string>(\'All\');\n  const [selectedStatus, setSelectedStatus] = useState<string>(\'All\');\n  const [sortBy, setSortBy] = useState<\'upvotes\' | \'newest\'>(\'upvotes\');\n\n  // Extract unique hostels/locations for filtering\n  const uniqueHostelLocations = useMemo(() => {\n    const locations = new Set<string>();\n    complaints.forEach((c) => {\n      // If location contains specific hostel naming or standard names\n      const loc = c.location.split(\'-\')[0].split(\'(\')[0].trim();\n      if (loc) locations.add(loc);\n    });\n    return Array.from(locations).sort();\n  }, [complaints]);\n\n  // Overall counts and statistics\n  const stats = useMemo(() => {\n    const total = complaints.length;\n    const underReview = complaints.filter((c) => c.status === \'Under Review\').length;\n    const resolved = complaints.filter((c) => c.status === \'Resolved\').length;\n    const highPriority = complaints.filter((c) => c.urgency === \'Urgent\' && c.status !== \'Resolved\').length;\n    return { total, underReview, resolved, highPriority };\n  }, [complaints]);\n\n  // Filter and sort complaints\n  const filteredComplaints = useMemo(() => {\n    return complaints\n      .filter((complaint) => {\n        // Search Filter\n        if (searchQuery.trim()) {\n          const q = searchQuery.toLowerCase().trim();\n          const matchesId = complaint.id.toLowerCase().includes(q);\n          const matchesDesc = complaint.description.toLowerCase().includes(q);\n          const matchesLoc = complaint.location.toLowerCase().includes(q);\n          const matchesCat = complaint.category.toLowerCase().includes(q);\n          if (!matchesId && !matchesDesc && !matchesLoc && !matchesCat) {\n            return false;\n          }\n        }\n\n        // Category Filter\n        if (selectedCategory !== \'All\' && complaint.category !== selectedCategory) {\n          return false;\n        }\n\n        // Hostel / Location Filter\n        if (selectedLocation !== \'All\' && !complaint.location.toLowerCase().includes(selectedLocation.toLowerCase())) {\n          return false;\n        }\n\n        // Status / Priority Filter\n        if (selectedStatus !== \'All\') {\n          if (selectedStatus === \'High Priority\') {\n            if (complaint.urgency !== \'Urgent\' || complaint.status === \'Resolved\') {\n              return false;\n            }\n          } else if (complaint.status !== selectedStatus) {\n            return false;\n          }\n        }\n\n        return true;\n      })\n      .sort((a, b) => {\n        if (sortBy === \'upvotes\') {\n          return b.upvotes - a.upvotes;\n        }\n        if (sortBy === \'newest\') {\n          return new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime();\n        }\n        return 0;\n      });\n  }, [complaints, searchQuery, selectedCategory, selectedLocation, selectedStatus, sortBy]);\n\n  const hasActiveFilters =\n    searchQuery !== \'\' ||\n    selectedCategory !== \'All\' ||\n    selectedLocation !== \'All\' ||\n    selectedStatus !== \'All\';\n\n  const resetFilters = () => {\n    setSearchQuery(\'\');\n    setSelectedCategory(\'All\');\n    setSelectedLocation(\'All\');\n    setSelectedStatus(\'All\');\n    setSortBy(\'upvotes\');\n  };\n\n  return (\n    <div className=\"max-w-7xl mx-auto py-8 sm:py-10 px-4 sm:px-6 lg:px-8\">\n      {/* Top Banner / Masthead */}\n      <div className=\"mb-8 border-b-2 border-[#1C1C1C] pb-6 flex flex-col md:flex-row md:items-end justify-between gap-6\">\n        <div>\n          <div className=\"flex items-center gap-2 mb-1.5\">\n            <span className=\"text-[10px] font-mono font-bold uppercase tracking-widest bg-[#1C1C1C] text-[#FAF9F6] px-2 py-0.5\">\n              PUBLIC GRIEVANCE FEED\n            </span>\n            <span className=\"text-[10px] font-mono text-[#1C1C1C]/60 uppercase tracking-wider flex items-center gap-1\">\n              <Lock className=\"w-3 h-3 text-red-700\" />\n              Untraceable Anonymous Submissions\n            </span>\n          </div>\n          <h1 className=\"font-serif-editorial text-3xl sm:text-4xl lg:text-5xl font-black text-[#1C1C1C] tracking-tight\">\n            Campus Grievance Ledger\n          </h1>\n          <p className=\"font-serif italic text-sm sm:text-base text-[#1C1C1C]/80 mt-1 max-w-2xl\">\n            Live public record of student grievances. Upvote critical issues to raise departmental priority. Click any card to inspect full details.\n          </p>\n        </div>\n\n        <button\n          id=\"feed-lodge-new-btn\"\n          type=\"button\"\n          onClick={onGoToSubmit}\n          className=\"px-6 py-3.5 bg-[#1C1C1C] hover:bg-red-700 text-[#FAF9F6] text-xs font-mono font-bold uppercase tracking-widest border-2 border-[#1C1C1C] transition-all shadow-[4px_4px_0px_0px_#1C1C1C] cursor-pointer shrink-0 flex items-center justify-center gap-2 hover:translate-x-[-1px] hover:translate-y-[-1px]\"\n        >\n          <PlusCircle className=\"w-4 h-4\" />\n          <span>Lodge Grievance</span>\n        </button>\n      </div>\n\n      {/* Overview Stat Counters with Status Colors */}\n      <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 mb-8\">\n        <div className=\"bg-[#FAF9F6] border-2 border-[#1C1C1C] p-4 shadow-[3px_3px_0px_0px_#1C1C1C]\">\n          <div className=\"text-[10px] font-mono font-bold uppercase tracking-wider text-[#1C1C1C]/60 mb-1\">\n            Total Grievances\n          </div>\n          <div className=\"text-3xl font-mono font-bold text-[#1C1C1C]\">\n            {stats.total}\n          </div>\n        </div>\n\n        {/* Yellow = Under Review */}\n        <div \n          onClick={() => setSelectedStatus(selectedStatus === \'Under Review\' ? \'All\' : \'Under Review\')}\n          className={`bg-[#FAF9F6] border-2 border-[#1C1C1C] p-4 shadow-[3px_3px_0px_0px_#1C1C1C] cursor-pointer transition-colors ${\n            selectedStatus === \'Under Review\' ? \'bg-amber-100/70 border-amber-800\' : \'hover:bg-amber-50/50\'\n          }`}\n        >\n          <div className=\"text-[10px] font-mono font-bold uppercase tracking-wider text-amber-950 mb-1 flex items-center gap-1.5\">\n            <span className=\"w-2 h-2 rounded-full bg-amber-500 animate-pulse\" />\n            Under Review (Yellow)\n          </div>\n          <div className=\"text-3xl font-mono font-bold text-amber-950\">\n            {stats.underReview}\n          </div>\n        </div>\n\n        {/* Green = Resolved */}\n        <div \n          onClick={() => setSelectedStatus(selectedStatus === \'Resolved\' ? \'All\' : \'Resolved\')}\n          className={`bg-[#FAF9F6] border-2 border-[#1C1C1C] p-4 shadow-[3px_3px_0px_0px_#1C1C1C] cursor-pointer transition-colors ${\n            selectedStatus === \'Resolved\' ? \'bg-emerald-100/70 border-emerald-800\' : \'hover:bg-emerald-50/50\'\n          }`}\n        >\n          <div className=\"text-[10px] font-mono font-bold uppercase tracking-wider text-emerald-950 mb-1 flex items-center gap-1.5\">\n            <span className=\"w-2 h-2 rounded-full bg-emerald-600\" />\n            Resolved (Green)\n          </div>\n          <div className=\"text-3xl font-mono font-bold text-emerald-950\">\n            {stats.resolved}\n          </div>\n        </div>\n\n        {/* Red = High Priority */}\n        <div \n          onClick={() => setSelectedStatus(selectedStatus === \'High Priority\' ? \'All\' : \'High Priority\')}\n          className={`bg-[#FAF9F6] border-2 border-[#1C1C1C] p-4 shadow-[3px_3px_0px_0px_#1C1C1C] cursor-pointer transition-colors ${\n            selectedStatus === \'High Priority\' ? \'bg-red-100/70 border-red-800\' : \'hover:bg-red-50/50\'\n          }`}\n        >\n          <div className=\"text-[10px] font-mono font-bold uppercase tracking-wider text-red-950 mb-1 flex items-center gap-1.5\">\n            <span className=\"w-2 h-2 rounded-full bg-red-600 animate-pulse\" />\n            High Priority (Red)\n          </div>\n          <div className=\"text-3xl font-mono font-bold text-red-950\">\n            {stats.highPriority}\n          </div>\n        </div>\n      </div>\n\n      {/* Filters & Sorting Controls */}\n      <div className=\"bg-[#FAF9F6] border-2 border-[#1C1C1C] p-4 sm:p-6 mb-8 shadow-[4px_4px_0px_0px_#1C1C1C]\">\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5\">\n          {/* Search Box */}\n          <div className=\"relative\">\n            <label htmlFor=\"feed-search-input\" className=\"block text-[10px] font-mono font-bold uppercase tracking-wider text-[#1C1C1C]/70 mb-1\">\n              Search Grievances\n            </label>\n            <div className=\"relative\">\n              <Search className=\"w-4 h-4 text-[#1C1C1C]/50 absolute left-3 top-2.5 pointer-events-none\" />\n              <input\n                id=\"feed-search-input\"\n                type=\"text\"\n                value={searchQuery}\n                onChange={(e) => setSearchQuery(e.target.value)}\n                placeholder=\"Search ID, room, or issue...\"\n                className=\"w-full bg-white border-2 border-[#1C1C1C] pl-9 pr-3 py-2 text-xs font-mono text-[#1C1C1C] placeholder:text-[#1C1C1C]/40 focus:outline-none focus:bg-stone-50\"\n              />\n            </div>\n          </div>\n\n          {/* Filter 1: Filter by Category */}\n          <div>\n            <label htmlFor=\"filter-category-select\" className=\"block text-[10px] font-mono font-bold uppercase tracking-wider text-[#1C1C1C]/70 mb-1\">\n              Filter by Category\n            </label>\n            <select\n              id=\"filter-category-select\"\n              value={selectedCategory}\n              onChange={(e) => setSelectedCategory(e.target.value)}\n              className=\"w-full bg-white border-2 border-[#1C1C1C] p-2 text-xs font-mono text-[#1C1C1C] focus:outline-none cursor-pointer\"\n            >\n              <option value=\"All\">All Categories</option>\n              {CATEGORIES.map((cat) => (\n                <option key={cat} value={cat}>\n                  {cat}\n                </option>\n              ))}\n            </select>\n          </div>\n\n          {/* Filter 2: Filter by Hostel / Location */}\n          <div>\n            <label htmlFor=\"filter-location-select\" className=\"block text-[10px] font-mono font-bold uppercase tracking-wider text-[#1C1C1C]/70 mb-1\">\n              Filter by Hostel / Area\n            </label>\n            <select\n              id=\"filter-location-select\"\n              value={selectedLocation}\n              onChange={(e) => setSelectedLocation(e.target.value)}\n              className=\"w-full bg-white border-2 border-[#1C1C1C] p-2 text-xs font-mono text-[#1C1C1C] focus:outline-none cursor-pointer truncate\"\n            >\n              <option value=\"All\">All Hostels & Locations</option>\n              {uniqueHostelLocations.map((loc) => (\n                <option key={loc} value={loc}>\n                  {loc}\n                </option>\n              ))}\n            </select>\n          </div>\n\n          {/* Filter 3: Filter by Status */}\n          <div>\n            <label htmlFor=\"filter-status-select\" className=\"block text-[10px] font-mono font-bold uppercase tracking-wider text-[#1C1C1C]/70 mb-1\">\n              Filter by Status\n            </label>\n            <select\n              id=\"filter-status-select\"\n              value={selectedStatus}\n              onChange={(e) => setSelectedStatus(e.target.value)}\n              className=\"w-full bg-white border-2 border-[#1C1C1C] p-2 text-xs font-mono text-[#1C1C1C] focus:outline-none cursor-pointer\"\n            >\n              {STATUS_FILTER_OPTIONS.map((st) => (\n                <option key={st} value={st}>\n                  {st === \'All\' ? \'All Statuses\' : st}\n                </option>\n              ))}\n            </select>\n          </div>\n        </div>\n\n        {/* Sort Controls & Filter Reset Row */}\n        <div className=\"flex flex-wrap items-center justify-between gap-3 mt-4 pt-3.5 border-t border-[#1C1C1C]/20 text-xs font-mono\">\n          {/* Sorting Buttons: \"Most Upvoted\" and \"Most Recent\" */}\n          <div className=\"flex items-center gap-2 flex-wrap\">\n            <span className=\"font-bold uppercase text-[#1C1C1C]/60 flex items-center gap-1\">\n              <ArrowUpDown className=\"w-3.5 h-3.5\" />\n              Sort By:\n            </span>\n            <div className=\"inline-flex gap-1\">\n              <button\n                id=\"sort-upvoted-btn\"\n                type=\"button\"\n                onClick={() => setSortBy(\'upvotes\')}\n                className={`px-3 py-1.5 uppercase text-xs font-bold border-2 transition-all cursor-pointer ${\n                  sortBy === \'upvotes\'\n                    ? \'bg-[#1C1C1C] text-white border-[#1C1C1C] shadow-[1px_1px_0px_0px_#1C1C1C]\'\n                    : \'bg-white text-[#1C1C1C] border-[#1C1C1C]/30 hover:bg-stone-100\'\n                }`}\n              >\n                Most Upvoted\n              </button>\n              <button\n                id=\"sort-recent-btn\"\n                type=\"button\"\n                onClick={() => setSortBy(\'newest\')}\n                className={`px-3 py-1.5 uppercase text-xs font-bold border-2 transition-all cursor-pointer ${\n                  sortBy === \'newest\'\n                    ? \'bg-[#1C1C1C] text-white border-[#1C1C1C] shadow-[1px_1px_0px_0px_#1C1C1C]\'\n                    : \'bg-white text-[#1C1C1C] border-[#1C1C1C]/30 hover:bg-stone-100\'\n                }`}\n              >\n                Most Recent\n              </button>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-3\">\n            <span className=\"text-[#1C1C1C]/70\">\n              Showing <strong>{filteredComplaints.length}</strong> of {complaints.length} records\n            </span>\n\n            {hasActiveFilters && (\n              <button\n                id=\"reset-filters-btn\"\n                type=\"button\"\n                onClick={resetFilters}\n                className=\"font-bold text-red-700 hover:underline cursor-pointer flex items-center gap-1 text-xs\"\n              >\n                <RotateCcw className=\"w-3 h-3\" />\n                <span>Reset Filters</span>\n              </button>\n            )}\n          </div>\n        </div>\n      </div>\n\n      {/* Card-Based Grid Layout */}\n      {filteredComplaints.length > 0 ? (\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n          {filteredComplaints.map((complaint) => (\n            <ComplaintCard\n              key={complaint.id}\n              complaint={complaint}\n              onUpvote={onUpvote}\n              onSelect={onSelectComplaint}\n              onOpenImage={onOpenImage}\n            />\n          ))}\n        </div>\n      ) : (\n        /* Empty State */\n        <div className=\"bg-[#FAF9F6] border-2 border-[#1C1C1C] p-12 text-center max-w-md mx-auto shadow-[4px_4px_0px_0px_#1C1C1C]\">\n          <div className=\"w-12 h-12 bg-[#1C1C1C] text-[#FAF9F6] flex items-center justify-center mx-auto mb-3\">\n            <Inbox className=\"w-6 h-6\" />\n          </div>\n          <h3 className=\"font-serif-editorial text-xl font-bold text-[#1C1C1C] mb-1\">\n            No Grievances Found\n          </h3>\n          <p className=\"font-serif italic text-xs text-[#1C1C1C]/70 mb-5\">\n            {hasActiveFilters\n              ? \'No complaints matched your selected category, status, or hostel filters.\'\n              : \'There are currently no complaints in the ledger.\'}\n          </p>\n\n          <div>\n            {hasActiveFilters ? (\n              <button\n                type=\"button\"\n                onClick={resetFilters}\n                className=\"px-4 py-2 bg-[#1C1C1C] text-[#FAF9F6] text-xs font-mono font-bold uppercase border-2 border-[#1C1C1C] hover:bg-stone-800 transition-colors cursor-pointer\"\n              >\n                Clear Search & Filters\n              </button>\n            ) : (\n              <button\n                type=\"button\"\n                onClick={onGoToSubmit}\n                className=\"px-4 py-2 bg-[#1C1C1C] text-[#FAF9F6] text-xs font-mono font-bold uppercase border-2 border-[#1C1C1C] hover:bg-stone-800 transition-colors cursor-pointer\"\n              >\n                Lodge First Grievance\n              </button>\n            )}\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
