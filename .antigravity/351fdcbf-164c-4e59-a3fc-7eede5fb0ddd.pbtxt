  file_change {
    absolute_path_uri: "file:///src/components/PublicFeed.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useMemo } from \'react\';\nimport { \n  Search, \n  Filter, \n  ArrowUpDown, \n  PlusCircle, \n  RotateCcw, \n  SlidersHorizontal,\n  Inbox,\n  CheckCircle2,\n  Clock,\n  AlertCircle,\n  Lock,\n  Sparkles\n} from \'lucide-react\';\nimport { Complaint, ComplaintCategory, ComplaintStatus } from \'../types\';\nimport { ComplaintCard } from \'./ComplaintCard\';\n\ninterface PublicFeedProps {\n  complaints: Complaint[];\n  onUpvote: (id: string) => void;\n  onOpenImage: (imageUrl: string, title: string) => void;\n  onStatusChange: (id: string, newStatus: ComplaintStatus) => void;\n  onGoToSubmit: () => void;\n  onResetToDefaultSeed?: () => void;\n}\n\nconst CATEGORIES: ComplaintCategory[] = [\n  \'Infrastructure\',\n  \'Mess/Food\',\n  \'Harassment\',\n  \'WiFi/Internet\',\n  \'Hygiene\',\n  \'Other\'\n];\n\nconst STATUSES: ComplaintStatus[] = [\n  \'Submitted\',\n  \'Under Review\',\n  \'Resolved\'\n];\n\nexport const PublicFeed: React.FC<PublicFeedProps> = ({\n  complaints,\n  onUpvote,\n  onOpenImage,\n  onStatusChange,\n  onGoToSubmit,\n  onResetToDefaultSeed,\n}) => {\n  const [searchQuery, setSearchQuery] = useState<string>(\'\');\n  const [selectedCategory, setSelectedCategory] = useState<string>(\'All\');\n  const [selectedLocation, setSelectedLocation] = useState<string>(\'All\');\n  const [selectedStatus, setSelectedStatus] = useState<string>(\'All\');\n  const [sortBy, setSortBy] = useState<\'upvotes\' | \'newest\' | \'oldest\'>(\'upvotes\');\n\n  // Extract unique locations from existing complaints\n  const uniqueLocations = useMemo(() => {\n    const locs = Array.from(new Set(complaints.map((c) => c.location)));\n    return locs.sort();\n  }, [complaints]);\n\n  // Aggregate metrics\n  const stats = useMemo(() => {\n    const total = complaints.length;\n    const submitted = complaints.filter((c) => c.status === \'Submitted\').length;\n    const underReview = complaints.filter((c) => c.status === \'Under Review\').length;\n    const resolved = complaints.filter((c) => c.status === \'Resolved\').length;\n    const totalUpvotes = complaints.reduce((sum, c) => sum + c.upvotes, 0);\n    return { total, submitted, underReview, resolved, totalUpvotes };\n  }, [complaints]);\n\n  // Filter & sort logic\n  const filteredComplaints = useMemo(() => {\n    return complaints\n      .filter((complaint) => {\n        // Search filter (matches ID, description, or location)\n        if (searchQuery.trim()) {\n          const q = searchQuery.toLowerCase().trim();\n          const matchesId = complaint.id.toLowerCase().includes(q);\n          const matchesDesc = complaint.description.toLowerCase().includes(q);\n          const matchesLoc = complaint.location.toLowerCase().includes(q);\n          const matchesCat = complaint.category.toLowerCase().includes(q);\n          if (!matchesId && !matchesDesc && !matchesLoc && !matchesCat) {\n            return false;\n          }\n        }\n\n        // Category filter\n        if (selectedCategory !== \'All\' && complaint.category !== selectedCategory) {\n          return false;\n        }\n\n        // Location filter\n        if (selectedLocation !== \'All\' && complaint.location !== selectedLocation) {\n          return false;\n        }\n\n        // Status filter\n        if (selectedStatus !== \'All\' && complaint.status !== selectedStatus) {\n          return false;\n        }\n\n        return true;\n      })\n      .sort((a, b) => {\n        if (sortBy === \'upvotes\') {\n          return b.upvotes - a.upvotes;\n        }\n        if (sortBy === \'newest\') {\n          return new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime();\n        }\n        if (sortBy === \'oldest\') {\n          return new Date(a.createdAt).getTime() - new Date(b.createdAt).getTime();\n        }\n        return 0;\n      });\n  }, [complaints, searchQuery, selectedCategory, selectedLocation, selectedStatus, sortBy]);\n\n  const hasActiveFilters =\n    searchQuery !== \'\' ||\n    selectedCategory !== \'All\' ||\n    selectedLocation !== \'All\' ||\n    selectedStatus !== \'All\';\n\n  const resetFilters = () => {\n    setSearchQuery(\'\');\n    setSelectedCategory(\'All\');\n    setSelectedLocation(\'All\');\n    setSelectedStatus(\'All\');\n    setSortBy(\'upvotes\');\n  };\n\n  return (\n    <div className=\"max-w-7xl mx-auto py-8 sm:py-10 px-4 sm:px-8\">\n      {/* Feed Header */}\n      <div className=\"mb-8 flex flex-col md:flex-row md:items-end justify-between gap-6\">\n        <div>\n          <div className=\"flex items-center gap-2 mb-2\">\n            <span className=\"text-xs font-bold uppercase tracking-wider text-blue-600 bg-blue-50 px-2.5 py-0.5 rounded-full\">\n              Live Public Ledger\n            </span>\n            <span className=\"text-xs text-slate-400 font-medium flex items-center gap-1\">\n              <Lock className=\"w-3 h-3 text-blue-600\" />\n              100% Anonymous Records\n            </span>\n          </div>\n          <h1 className=\"text-2xl sm:text-3xl lg:text-4xl font-bold text-slate-900 tracking-tight\">\n            Campus Grievance Tracking Board\n          </h1>\n          <p className=\"text-sm text-slate-500 mt-1 max-w-2xl\">\n            Track reported campus issues, upvote community concerns to raise urgency, and monitor administrative resolutions.\n          </p>\n        </div>\n\n        <button\n          id=\"feed-lodge-new-btn\"\n          type=\"button\"\n          onClick={onGoToSubmit}\n          className=\"inline-flex items-center justify-center gap-2 px-6 py-3.5 bg-blue-600 hover:bg-blue-700 active:bg-blue-800 text-white text-xs sm:text-sm font-semibold rounded-xl transition-all shadow-sm hover:shadow-md cursor-pointer shrink-0\"\n        >\n          <PlusCircle className=\"w-4 h-4\" />\n          <span>Report New Grievance</span>\n        </button>\n      </div>\n\n      {/* Summary Stat Counters */}\n      <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-3.5 mb-8\">\n        <div className=\"bg-white border border-slate-200/90 rounded-2xl p-4 sm:p-5 shadow-xs\">\n          <div className=\"text-xs font-semibold text-slate-400 uppercase tracking-wider mb-1\">\n            Total Reports\n          </div>\n          <div className=\"text-2xl sm:text-3xl font-bold text-slate-900 font-mono\">\n            {stats.total}\n          </div>\n        </div>\n\n        <div className=\"bg-white border border-slate-200/90 rounded-2xl p-4 sm:p-5 shadow-xs\">\n          <div className=\"text-xs font-semibold text-blue-600 uppercase tracking-wider mb-1 flex items-center gap-1.5\">\n            <span className=\"w-2 h-2 rounded-full bg-blue-500\" />\n            Submitted\n          </div>\n          <div className=\"text-2xl sm:text-3xl font-bold text-blue-700 font-mono\">\n            {stats.submitted}\n          </div>\n        </div>\n\n        <div className=\"bg-white border border-slate-200/90 rounded-2xl p-4 sm:p-5 shadow-xs\">\n          <div className=\"text-xs font-semibold text-amber-600 uppercase tracking-wider mb-1 flex items-center gap-1.5\">\n            <span className=\"w-2 h-2 rounded-full bg-amber-500 animate-pulse\" />\n            Under Review\n          </div>\n          <div className=\"text-2xl sm:text-3xl font-bold text-amber-700 font-mono\">\n            {stats.underReview}\n          </div>\n        </div>\n\n        <div className=\"bg-white border border-slate-200/90 rounded-2xl p-4 sm:p-5 shadow-xs\">\n          <div className=\"text-xs font-semibold text-emerald-600 uppercase tracking-wider mb-1 flex items-center gap-1.5\">\n            <span className=\"w-2 h-2 rounded-full bg-emerald-500\" />\n            Resolved\n          </div>\n          <div className=\"text-2xl sm:text-3xl font-bold text-emerald-700 font-mono\">\n            {stats.resolved}\n          </div>\n        </div>\n      </div>\n\n      {/* Filter and Search Bar */}\n      <div className=\"bg-white border border-slate-200/90 rounded-2xl p-5 sm:p-6 mb-8 shadow-xs\">\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3.5\">\n          {/* Search by ID / Keyword */}\n          <div className=\"lg:col-span-2 relative\">\n            <Search className=\"w-4 h-4 text-slate-400 absolute left-3.5 top-3.5 pointer-events-none\" />\n            <input\n              id=\"feed-search-input\"\n              type=\"text\"\n              value={searchQuery}\n              onChange={(e) => setSearchQuery(e.target.value)}\n              placeholder=\"Search by SAGE-XXXX ID, keyword, or room...\"\n              className=\"w-full bg-slate-50/70 border border-slate-200 hover:border-slate-300 focus:bg-white focus:border-blue-500 focus:ring-3 focus:ring-blue-100 rounded-xl pl-10 pr-3.5 py-2.5 text-xs sm:text-sm text-slate-800 transition-all placeholder:text-slate-400\"\n            />\n          </div>\n\n          {/* Category Filter */}\n          <div>\n            <label htmlFor=\"filter-category-select\" className=\"sr-only\">Filter by Category</label>\n            <select\n              id=\"filter-category-select\"\n              value={selectedCategory}\n              onChange={(e) => setSelectedCategory(e.target.value)}\n              className=\"w-full bg-slate-50/70 border border-slate-200 hover:border-slate-300 focus:bg-white focus:border-blue-500 focus:ring-3 focus:ring-blue-100 rounded-xl p-2.5 text-xs sm:text-sm text-slate-800 transition-all cursor-pointer font-medium\"\n            >\n              <option value=\"All\">All Categories</option>\n              {CATEGORIES.map((cat) => (\n                <option key={cat} value={cat}>\n                  {cat}\n                </option>\n              ))}\n            </select>\n          </div>\n\n          {/* Location Filter */}\n          <div>\n            <label htmlFor=\"filter-location-select\" className=\"sr-only\">Filter by Location</label>\n            <select\n              id=\"filter-location-select\"\n              value={selectedLocation}\n              onChange={(e) => setSelectedLocation(e.target.value)}\n              className=\"w-full bg-slate-50/70 border border-slate-200 hover:border-slate-300 focus:bg-white focus:border-blue-500 focus:ring-3 focus:ring-blue-100 rounded-xl p-2.5 text-xs sm:text-sm text-slate-800 transition-all cursor-pointer font-medium truncate\"\n            >\n              <option value=\"All\">All Locations</option>\n              {uniqueLocations.map((loc) => (\n                <option key={loc} value={loc}>\n                  {loc}\n                </option>\n              ))}\n            </select>\n          </div>\n\n          {/* Status Filter */}\n          <div>\n            <label htmlFor=\"filter-status-select\" className=\"sr-only\">Filter by Status</label>\n            <select\n              id=\"filter-status-select\"\n              value={selectedStatus}\n              onChange={(e) => setSelectedStatus(e.target.value)}\n              className=\"w-full bg-slate-50/70 border border-slate-200 hover:border-slate-300 focus:bg-white focus:border-blue-500 focus:ring-3 focus:ring-blue-100 rounded-xl p-2.5 text-xs sm:text-sm text-slate-800 transition-all cursor-pointer font-medium\"\n            >\n              <option value=\"All\">All Statuses</option>\n              {STATUSES.map((st) => (\n                <option key={st} value={st}>\n                  {st}\n                </option>\n              ))}\n            </select>\n          </div>\n        </div>\n\n        {/* Secondary Row: Sorting & Reset */}\n        <div className=\"flex flex-wrap items-center justify-between gap-4 mt-4 pt-4 border-t border-slate-100 text-xs\">\n          <div className=\"flex items-center gap-2 flex-wrap\">\n            <span className=\"text-xs font-semibold text-slate-400 flex items-center gap-1\">\n              <ArrowUpDown className=\"w-3.5 h-3.5\" />\n              Sort By:\n            </span>\n            <div className=\"inline-flex gap-1.5\">\n              <button\n                type=\"button\"\n                onClick={() => setSortBy(\'upvotes\')}\n                className={`px-3 py-1 text-xs font-semibold rounded-lg border transition-all cursor-pointer ${\n                  sortBy === \'upvotes\'\n                    ? \'bg-blue-600 text-white border-blue-600 shadow-xs\'\n                    : \'bg-slate-50 hover:bg-slate-100 text-slate-600 border-slate-200\'\n                }`}\n              >\n                Most Upvoted\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => setSortBy(\'newest\')}\n                className={`px-3 py-1 text-xs font-semibold rounded-lg border transition-all cursor-pointer ${\n                  sortBy === \'newest\'\n                    ? \'bg-blue-600 text-white border-blue-600 shadow-xs\'\n                    : \'bg-slate-50 hover:bg-slate-100 text-slate-600 border-slate-200\'\n                }`}\n              >\n                Newest First\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => setSortBy(\'oldest\')}\n                className={`px-3 py-1 text-xs font-semibold rounded-lg border transition-all cursor-pointer ${\n                  sortBy === \'oldest\'\n                    ? \'bg-blue-600 text-white border-blue-600 shadow-xs\'\n                    : \'bg-slate-50 hover:bg-slate-100 text-slate-600 border-slate-200\'\n                }`}\n              >\n                Oldest First\n              </button>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-3\">\n            <span className=\"text-xs text-slate-500\">\n              Showing <strong className=\"text-slate-800\">{filteredComplaints.length}</strong> of {complaints.length} grievances\n            </span>\n\n            {hasActiveFilters && (\n              <button\n                id=\"reset-filters-btn\"\n                type=\"button\"\n                onClick={resetFilters}\n                className=\"text-xs font-semibold text-blue-600 hover:text-blue-800 cursor-pointer flex items-center gap-1\"\n              >\n                <RotateCcw className=\"w-3 h-3\" />\n                <span>Reset Filters</span>\n              </button>\n            )}\n          </div>\n        </div>\n      </div>\n\n      {/* Grievance Grid */}\n      {filteredComplaints.length > 0 ? (\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-5\">\n          {filteredComplaints.map((complaint) => (\n            <ComplaintCard\n              key={complaint.id}\n              complaint={complaint}\n              onUpvote={onUpvote}\n              onOpenImage={onOpenImage}\n              onStatusChange={onStatusChange}\n            />\n          ))}\n        </div>\n      ) : (\n        /* Empty State */\n        <div className=\"bg-white border border-slate-200/90 rounded-2xl p-12 text-center max-w-md mx-auto shadow-xs\">\n          <div className=\"w-14 h-14 bg-blue-50 text-blue-600 rounded-full flex items-center justify-center mx-auto mb-4\">\n            <Inbox className=\"w-7 h-7\" />\n          </div>\n          <h3 className=\"text-lg font-bold text-slate-900 mb-1.5\">\n            No Grievance Reports Found\n          </h3>\n          <p className=\"text-xs sm:text-sm text-slate-500 mb-6 leading-relaxed\">\n            {hasActiveFilters\n              ? \'No complaints matched your search or active category/location filter.\'\n              : \'There are currently no complaints in the ledger.\'}\n          </p>\n\n          <div>\n            {hasActiveFilters ? (\n              <button\n                type=\"button\"\n                onClick={resetFilters}\n                className=\"px-5 py-2.5 bg-blue-600 text-white text-xs font-semibold rounded-xl hover:bg-blue-700 transition-colors cursor-pointer\"\n              >\n                Clear Search & Filters\n              </button>\n            ) : (\n              <button\n                type=\"button\"\n                onClick={onGoToSubmit}\n                className=\"px-5 py-2.5 bg-blue-600 text-white text-xs font-semibold rounded-xl hover:bg-blue-700 transition-colors cursor-pointer\"\n              >\n                Submit First Grievance\n              </button>\n            )}\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
