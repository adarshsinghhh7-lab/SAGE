        replacement_content: "export function getStatusBadgeStyle(status: ComplaintStatus, urgency?: string): {\n  bg: string;\n  text: string;\n  border: string;\n  dot: string;\n} {\n  if (urgency === \'Urgent\' && status !== \'Resolved\') {\n    return {\n      bg: \'bg-red-100\',\n      text: \'text-red-950\',\n      border: \'border-red-500\',\n      dot: \'bg-red-600 animate-pulse\',\n    };\n  }\n\n  switch (status) {\n    case \'Submitted\':\n      return {\n        bg: \'bg-stone-100\',\n        text: \'text-stone-800\',\n        border: \'border-stone-300\',\n        dot: \'bg-stone-600\',\n      };\n    case \'Under Review\':\n      return {\n        bg: \'bg-amber-100\',\n        text: \'text-amber-950\',\n        border: \'border-amber-400\',\n        dot: \'bg-amber-600 animate-pulse\',\n      };\n    case \'Resolved\':\n      return {\n        bg: \'bg-emerald-100\',\n        text: \'text-emerald-950\',\n        border: \'border-emerald-500\',\n        dot: \'bg-emerald-700\',\n      };\n  }\n}"
