  file_change {
    absolute_path_uri: "file:///src/components/PublicFeed.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useMemo } from \'react\';\nimport { \n  Search, \n  Filter, \n  ArrowUpDown, \n  PlusCircle, \n  RotateCcw, \n  Inbox,\n  CheckCircle2,\n  Clock,\n  AlertCircle,\n  Lock,\n  Sparkles\n} from \'lucide-react\';\nimport { Complaint, ComplaintCategory, ComplaintStatus } from \'../types\';\nimport { ComplaintCard } from \'./ComplaintCard\';\n\ninterface PublicFeedProps {\n  complaints: Complaint[];\n  onUpvote: (id: string) => void;\n  onOpenImage: (imageUrl: string, title: string) => void;\n  onStatusChange: (id: string, newStatus: ComplaintStatus) => void;\n  onGoToSubmit: () => void;\n  onResetToDefaultSeed?: () => void;\n}\n\nconst CATEGORIES: ComplaintCategory[] = [\n  \'Infrastructure\',\n  \'Mess/Food\',\n  \'Harassment\',\n  \'WiFi/Internet\',\n  \'Hygiene\',\n  \'Other\'\n];\n\nconst STATUSES: ComplaintStatus[] = [\n  \'Submitted\',\n  \'Under Review\',\n  \'Resolved\'\n];\n\nexport const PublicFeed: React.FC<PublicFeedProps> = ({\n  complaints,\n  onUpvote,\n  onOpenImage,\n  onStatusChange,\n  onGoToSubmit,\n  onResetToDefaultSeed,\n}) => {\n  const [searchQuery, setSearchQuery] = useState<string>(\'\');\n  const [selectedCategory, setSelectedCategory] = useState<string>(\'All\');\n  const [selectedLocation, setSelectedLocation] = useState<string>(\'All\');\n  const [selectedStatus, setSelectedStatus] = useState<string>(\'All\');\n  const [sortBy, setSortBy] = useState<\'upvotes\' | \'newest\' | \'oldest\'>(\'upvotes\');\n\n  const uniqueLocations = useMemo(() => {\n    const locs = Array.from(new Set(complaints.map((c) => c.location)));\n    return locs.sort();\n  }, [complaints]);\n\n  const stats = useMemo(() => {\n    const total = complaints.length;\n    const submitted = complaints.filter((c) => c.status === \'Submitted\').length;\n    const underReview = complaints.filter((c) => c.status === \'Under Review\').length;\n    const resolved = complaints.filter((c) => c.status === \'Resolved\').length;\n    const totalUpvotes = complaints.reduce((sum, c) => sum + c.upvotes, 0);\n    return { total, submitted, underReview, resolved, totalUpvotes };\n  }, [complaints]);\n\n  const filteredComplaints = useMemo(() => {\n    return complaints\n      .filter((complaint) => {\n        if (searchQuery.trim()) {\n          const q = searchQuery.toLowerCase().trim();\n          const matchesId = complaint.id.toLowerCase().includes(q);\n          const matchesDesc = complaint.description.toLowerCase().includes(q);\n          const matchesLoc = complaint.location.toLowerCase().includes(q);\n          const matchesCat = complaint.category.toLowerCase().includes(q);\n          if (!matchesId && !matchesDesc && !matchesLoc && !matchesCat) {\n            return false;\n          }\n        }\n\n        if (selectedCategory !== \'All\' && complaint.category !== selectedCategory) {\n          return false;\n        }\n\n        if (selectedLocation !== \'All\' && complaint.location !== selectedLocation) {\n          return false;\n        }\n\n        if (selectedStatus !== \'All\' && complaint.status !== selectedStatus) {\n          return false;\n        }\n\n        return true;\n      })\n      .sort((a, b) => {\n        if (sortBy === \'upvotes\') {\n          return b.upvotes - a.upvotes;\n        }\n        if (sortBy === \'newest\') {\n          return new Date(b.createdAt).getTime() - new Date(a.createdAt).getTime();\n        }\n        if (sortBy === \'oldest\') {\n          return new Date(a.createdAt).getTime() - new Date(b.createdAt).getTime();\n        }\n        return 0;\n      });\n  }, [complaints, searchQuery, selectedCategory, selectedLocation, selectedStatus, sortBy]);\n\n  const hasActiveFilters =\n    searchQuery !== \'\' ||\n    selectedCategory !== \'All\' ||\n    selectedLocation !== \'All\' ||\n    selectedStatus !== \'All\';\n\n  const resetFilters = () => {\n    setSearchQuery(\'\');\n    setSelectedCategory(\'All\');\n    setSelectedLocation(\'All\');\n    setSelectedStatus(\'All\');\n    setSortBy(\'upvotes\');\n  };\n\n  return (\n    <div className=\"max-w-7xl mx-auto py-8 sm:py-10 px-4 sm:px-6 lg:px-8\">\n      {/* Editorial Masthead Banner */}\n      <div className=\"mb-8 border-b-2 border-[#1C1C1C] pb-6 flex flex-col md:flex-row md:items-end justify-between gap-6\">\n        <div>\n          <div className=\"flex items-center gap-2 mb-1.5\">\n            <span className=\"text-[10px] font-mono font-bold uppercase tracking-widest bg-[#1C1C1C] text-[#FAF9F6] px-2 py-0.5\">\n              PUBLIC LEDGER DISPATCH\n            </span>\n            <span className=\"text-[10px] font-mono text-[#1C1C1C]/60 uppercase tracking-wider flex items-center gap-1\">\n              <Lock className=\"w-3 h-3 text-red-700\" />\n              100% Cryptographic Anonymity\n            </span>\n          </div>\n          <h1 className=\"font-serif-editorial text-3xl sm:text-4xl lg:text-5xl font-black text-[#1C1C1C] tracking-tight\">\n            Campus Grievance Ledger\n          </h1>\n          <p className=\"font-serif italic text-sm sm:text-base text-[#1C1C1C]/80 mt-1 max-w-2xl\">\n            Real-time public record of student-reported infrastructure, mess, hygiene, and welfare issues under administrative review.\n          </p>\n        </div>\n\n        <button\n          id=\"feed-lodge-new-btn\"\n          type=\"button\"\n          onClick={onGoToSubmit}\n          className=\"px-6 py-3.5 bg-[#1C1C1C] hover:bg-red-700 text-[#FAF9F6] text-xs font-mono font-bold uppercase tracking-widest border-2 border-[#1C1C1C] transition-all shadow-[4px_4px_0px_0px_#1C1C1C] cursor-pointer shrink-0 flex items-center justify-center gap-2\"\n        >\n          <PlusCircle className=\"w-4 h-4\" />\n          <span>Lodge Grievance</span>\n        </button>\n      </div>\n\n      {/* Ledger Stats Row */}\n      <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 mb-8\">\n        <div className=\"bg-[#FAF9F6] border-2 border-[#1C1C1C] p-4 shadow-[3px_3px_0px_0px_#1C1C1C]\">\n          <div className=\"text-[10px] font-mono font-bold uppercase tracking-wider text-[#1C1C1C]/60 mb-1\">\n            Total Deposited\n          </div>\n          <div className=\"text-3xl font-mono font-bold text-[#1C1C1C]\">\n            {stats.total}\n          </div>\n        </div>\n\n        <div className=\"bg-[#FAF9F6] border-2 border-[#1C1C1C] p-4 shadow-[3px_3px_0px_0px_#1C1C1C]\">\n          <div className=\"text-[10px] font-mono font-bold uppercase tracking-wider text-[#1C1C1C]/70 mb-1 flex items-center gap-1.5\">\n            <span className=\"w-2 h-2 rounded-full bg-stone-600\" />\n            Submitted\n          </div>\n          <div className=\"text-3xl font-mono font-bold text-[#1C1C1C]\">\n            {stats.submitted}\n          </div>\n        </div>\n\n        <div className=\"bg-[#FAF9F6] border-2 border-[#1C1C1C] p-4 shadow-[3px_3px_0px_0px_#1C1C1C]\">\n          <div className=\"text-[10px] font-mono font-bold uppercase tracking-wider text-amber-900 mb-1 flex items-center gap-1.5\">\n            <span className=\"w-2 h-2 rounded-full bg-amber-600 animate-pulse\" />\n            Under Review\n          </div>\n          <div className=\"text-3xl font-mono font-bold text-amber-900\">\n            {stats.underReview}\n          </div>\n        </div>\n\n        <div className=\"bg-[#FAF9F6] border-2 border-[#1C1C1C] p-4 shadow-[3px_3px_0px_0px_#1C1C1C]\">\n          <div className=\"text-[10px] font-mono font-bold uppercase tracking-wider text-emerald-900 mb-1 flex items-center gap-1.5\">\n            <span className=\"w-2 h-2 rounded-full bg-emerald-700\" />\n            Resolved\n          </div>\n          <div className=\"text-3xl font-mono font-bold text-emerald-900\">\n            {stats.resolved}\n          </div>\n        </div>\n      </div>\n\n      {/* Filter and Search Box */}\n      <div className=\"bg-[#FAF9F6] border-2 border-[#1C1C1C] p-4 sm:p-6 mb-8 shadow-[4px_4px_0px_0px_#1C1C1C]\">\n        <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3\">\n          {/* Search Box */}\n          <div className=\"lg:col-span-2 relative\">\n            <Search className=\"w-4 h-4 text-[#1C1C1C]/50 absolute left-3.5 top-3 pointer-events-none\" />\n            <input\n              id=\"feed-search-input\"\n              type=\"text\"\n              value={searchQuery}\n              onChange={(e) => setSearchQuery(e.target.value)}\n              placeholder=\"Filter by SAGE-XXXX ID, room, or keyword...\"\n              className=\"w-full bg-white border-2 border-[#1C1C1C] pl-10 pr-3 py-2 text-xs font-mono text-[#1C1C1C] placeholder:text-[#1C1C1C]/40 focus:outline-none focus:bg-stone-50\"\n            />\n          </div>\n\n          {/* Category Filter */}\n          <div>\n            <label htmlFor=\"filter-category-select\" className=\"sr-only\">Filter Category</label>\n            <select\n              id=\"filter-category-select\"\n              value={selectedCategory}\n              onChange={(e) => setSelectedCategory(e.target.value)}\n              className=\"w-full bg-white border-2 border-[#1C1C1C] p-2 text-xs font-mono text-[#1C1C1C] focus:outline-none cursor-pointer\"\n            >\n              <option value=\"All\">All Categories</option>\n              {CATEGORIES.map((cat) => (\n                <option key={cat} value={cat}>\n                  {cat}\n                </option>\n              ))}\n            </select>\n          </div>\n\n          {/* Location Filter */}\n          <div>\n            <label htmlFor=\"filter-location-select\" className=\"sr-only\">Filter Location</label>\n            <select\n              id=\"filter-location-select\"\n              value={selectedLocation}\n              onChange={(e) => setSelectedLocation(e.target.value)}\n              className=\"w-full bg-white border-2 border-[#1C1C1C] p-2 text-xs font-mono text-[#1C1C1C] focus:outline-none cursor-pointer truncate\"\n            >\n              <option value=\"All\">All Locations</option>\n              {uniqueLocations.map((loc) => (\n                <option key={loc} value={loc}>\n                  {loc}\n                </option>\n              ))}\n            </select>\n          </div>\n\n          {/* Status Filter */}\n          <div>\n            <label htmlFor=\"filter-status-select\" className=\"sr-only\">Filter Status</label>\n            <select\n              id=\"filter-status-select\"\n              value={selectedStatus}\n              onChange={(e) => setSelectedStatus(e.target.value)}\n              className=\"w-full bg-white border-2 border-[#1C1C1C] p-2 text-xs font-mono text-[#1C1C1C] focus:outline-none cursor-pointer\"\n            >\n              <option value=\"All\">All Statuses</option>\n              {STATUSES.map((st) => (\n                <option key={st} value={st}>\n                  {st}\n                </option>\n              ))}\n            </select>\n          </div>\n        </div>\n\n        {/* Sort & Status Row */}\n        <div className=\"flex flex-wrap items-center justify-between gap-3 mt-4 pt-3 border-t border-[#1C1C1C]/20 text-xs font-mono\">\n          <div className=\"flex items-center gap-2 flex-wrap\">\n            <span className=\"font-bold uppercase text-[#1C1C1C]/60 flex items-center gap-1\">\n              <ArrowUpDown className=\"w-3 h-3\" />\n              Order:\n            </span>\n            <div className=\"inline-flex gap-1\">\n              <button\n                type=\"button\"\n                onClick={() => setSortBy(\'upvotes\')}\n                className={`px-2.5 py-1 uppercase text-[11px] font-bold border transition-all cursor-pointer ${\n                  sortBy === \'upvotes\'\n                    ? \'bg-[#1C1C1C] text-white border-[#1C1C1C]\'\n                    : \'bg-white text-[#1C1C1C] border-[#1C1C1C]/30 hover:bg-stone-100\'\n                }`}\n              >\n                Endorsements\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => setSortBy(\'newest\')}\n                className={`px-2.5 py-1 uppercase text-[11px] font-bold border transition-all cursor-pointer ${\n                  sortBy === \'newest\'\n                    ? \'bg-[#1C1C1C] text-white border-[#1C1C1C]\'\n                    : \'bg-white text-[#1C1C1C] border-[#1C1C1C]/30 hover:bg-stone-100\'\n                }`}\n              >\n                Newest\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => setSortBy(\'oldest\')}\n                className={`px-2.5 py-1 uppercase text-[11px] font-bold border transition-all cursor-pointer ${\n                  sortBy === \'oldest\'\n                    ? \'bg-[#1C1C1C] text-white border-[#1C1C1C]\'\n                    : \'bg-white text-[#1C1C1C] border-[#1C1C1C]/30 hover:bg-stone-100\'\n                }`}\n              >\n                Oldest\n              </button>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-3\">\n            <span className=\"text-[#1C1C1C]/70\">\n              Showing <strong>{filteredComplaints.length}</strong> of {complaints.length} entries\n            </span>\n\n            {hasActiveFilters && (\n              <button\n                id=\"reset-filters-btn\"\n                type=\"button\"\n                onClick={resetFilters}\n                className=\"font-bold text-red-700 hover:underline cursor-pointer flex items-center gap-1\"\n              >\n                <RotateCcw className=\"w-3 h-3\" />\n                <span>Reset</span>\n              </button>\n            )}\n          </div>\n        </div>\n      </div>\n\n      {/* Grievance Grid */}\n      {filteredComplaints.length > 0 ? (\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n          {filteredComplaints.map((complaint) => (\n            <ComplaintCard\n              key={complaint.id}\n              complaint={complaint}\n              onUpvote={onUpvote}\n              onOpenImage={onOpenImage}\n              onStatusChange={onStatusChange}\n            />\n          ))}\n        </div>\n      ) : (\n        /* Empty State */\n        <div className=\"bg-[#FAF9F6] border-2 border-[#1C1C1C] p-12 text-center max-w-md mx-auto shadow-[4px_4px_0px_0px_#1C1C1C]\">\n          <div className=\"w-12 h-12 bg-[#1C1C1C] text-[#FAF9F6] flex items-center justify-center mx-auto mb-3\">\n            <Inbox className=\"w-6 h-6\" />\n          </div>\n          <h3 className=\"font-serif-editorial text-xl font-bold text-[#1C1C1C] mb-1\">\n            No Ledger Records Found\n          </h3>\n          <p className=\"font-serif italic text-xs text-[#1C1C1C]/70 mb-5\">\n            {hasActiveFilters\n              ? \'No complaints matched your search filter criteria.\'\n              : \'There are currently no complaints in the ledger.\'}\n          </p>\n\n          <div>\n            {hasActiveFilters ? (\n              <button\n                type=\"button\"\n                onClick={resetFilters}\n                className=\"px-4 py-2 bg-[#1C1C1C] text-[#FAF9F6] text-xs font-mono font-bold uppercase border-2 border-[#1C1C1C] hover:bg-stone-800 transition-colors cursor-pointer\"\n              >\n                Clear Search & Filters\n              </button>\n            ) : (\n              <button\n                type=\"button\"\n                onClick={onGoToSubmit}\n                className=\"px-4 py-2 bg-[#1C1C1C] text-[#FAF9F6] text-xs font-mono font-bold uppercase border-2 border-[#1C1C1C] hover:bg-stone-800 transition-colors cursor-pointer\"\n              >\n                Lodge First Grievance\n              </button>\n            )}\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n"
