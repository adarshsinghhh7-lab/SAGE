  file_change {
    absolute_path_uri: "file:///src/components/ComplaintDetail.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { \n  ArrowLeft, \n  ArrowBigUp, \n  MapPin, \n  Clock, \n  Tag, \n  ShieldCheck, \n  Check, \n  Copy, \n  Image as ImageIcon, \n  ExternalLink, \n  Lock, \n  AlertTriangle,\n  FileText,\n  ChevronDown,\n  CheckCircle2,\n  Share2\n} from \'lucide-react\';\nimport { Complaint, ComplaintStatus } from \'../types\';\nimport { getCategoryBadgeStyle, getStatusBadgeStyle, formatTimeAgo } from \'../utils/formatters\';\n\ninterface ComplaintDetailProps {\n  complaint: Complaint;\n  onBackToFeed: () => void;\n  onUpvote: (id: string) => void;\n  onOpenImage: (imageUrl: string, title: string) => void;\n  onStatusChange: (id: string, newStatus: ComplaintStatus) => void;\n  onGoToSubmit: () => void;\n}\n\nexport const ComplaintDetail: React.FC<ComplaintDetailProps> = ({\n  complaint,\n  onBackToFeed,\n  onUpvote,\n  onOpenImage,\n  onStatusChange,\n  onGoToSubmit,\n}) => {\n  const [copied, setCopied] = useState<boolean>(false);\n  const [showStatusMenu, setShowStatusMenu] = useState<boolean>(false);\n\n  const catStyle = getCategoryBadgeStyle(complaint.category);\n  const statusStyle = getStatusBadgeStyle(complaint.status, complaint.urgency);\n\n  const isHighPriority = complaint.urgency === \'Urgent\' && complaint.status !== \'Resolved\';\n  const isUnderReview = complaint.status === \'Under Review\';\n  const isResolved = complaint.status === \'Resolved\';\n\n  const copyIdToClipboard = () => {\n    navigator.clipboard.writeText(complaint.id);\n    setCopied(true);\n    setTimeout(() => setCopied(false), 2500);\n  };\n\n  const handleUpvote = () => {\n    if (!complaint.hasUpvoted) {\n      onUpvote(complaint.id);\n    }\n  };\n\n  // Format exact date\n  const formattedExactDate = new Date(complaint.createdAt).toLocaleString(\'en-US\', {\n    month: \'short\',\n    day: \'numeric\',\n    year: \'numeric\',\n    hour: \'2-digit\',\n    minute: \'2-digit\',\n  });\n\n  return (\n    <div className=\"max-w-4xl mx-auto py-8 sm:py-12 px-4 sm:px-6\">\n      {/* Navigation Breadcrumb */}\n      <div className=\"mb-6 flex items-center justify-between gap-4\">\n        <button\n          id=\"back-to-feed-btn\"\n          type=\"button\"\n          onClick={onBackToFeed}\n          className=\"inline-flex items-center gap-2 px-4 py-2 text-xs font-mono font-bold uppercase tracking-wider text-[#1C1C1C] border-2 border-[#1C1C1C] bg-white hover:bg-stone-200 transition-colors cursor-pointer shadow-[2px_2px_0px_0px_#1C1C1C]\"\n        >\n          <ArrowLeft className=\"w-4 h-4\" />\n          <span>Back to Public Ledger</span>\n        </button>\n\n        <div className=\"flex items-center gap-2\">\n          <button\n            type=\"button\"\n            onClick={copyIdToClipboard}\n            className=\"inline-flex items-center gap-1.5 px-3 py-2 text-xs font-mono font-bold uppercase border-2 border-[#1C1C1C] bg-[#FAF9F6] hover:bg-stone-100 cursor-pointer shadow-[2px_2px_0px_0px_#1C1C1C]\"\n            title=\"Copy Complaint ID\"\n          >\n            {copied ? (\n              <>\n                <Check className=\"w-3.5 h-3.5 text-emerald-700\" />\n                <span className=\"text-emerald-800\">Copied</span>\n              </>\n            ) : (\n              <>\n                <Copy className=\"w-3.5 h-3.5\" />\n                <span>{complaint.id}</span>\n              </>\n            )}\n          </button>\n        </div>\n      </div>\n\n      {/* Main Deposition Detail Container */}\n      <div className=\"bg-[#FAF9F6] border-2 border-[#1C1C1C] p-6 sm:p-10 shadow-[6px_6px_0px_0px_#1C1C1C]\">\n        {/* Header Section */}\n        <div className=\"border-b-2 border-[#1C1C1C] pb-6 mb-6\">\n          <div className=\"flex flex-wrap items-center justify-between gap-3 mb-4\">\n            <div className=\"flex items-center gap-2.5 flex-wrap\">\n              <span className=\"text-xl sm:text-2xl font-mono font-bold bg-[#1C1C1C] text-[#FAF9F6] px-3 py-1 tracking-wider select-all\">\n                {complaint.id}\n              </span>\n\n              <span className={`inline-flex items-center gap-1.5 text-xs font-mono font-bold uppercase px-3 py-1 border ${catStyle.bg} ${catStyle.text} ${catStyle.border}`}>\n                <span className={`w-2 h-2 rounded-full ${catStyle.indicator}`} />\n                {complaint.category}\n              </span>\n\n              {isHighPriority && (\n                <span className=\"inline-flex items-center gap-1 text-xs font-mono font-bold uppercase px-2.5 py-1 bg-red-100 text-red-950 border-2 border-red-600 shadow-[1px_1px_0px_0px_#991b1b]\">\n                  <span className=\"w-2 h-2 rounded-full bg-red-600 animate-pulse\" />\n                  <span>High Priority</span>\n                </span>\n              )}\n            </div>\n\n            {/* Current Status Badge + Interactive Demonstration Switcher */}\n            <div className=\"relative\">\n              <button\n                type=\"button\"\n                onClick={() => setShowStatusMenu(!showStatusMenu)}\n                className={`inline-flex items-center gap-2 px-3.5 py-1.5 text-xs font-mono font-bold uppercase border-2 cursor-pointer ${statusStyle.bg} ${statusStyle.text} ${statusStyle.border}`}\n                title=\"Click to update status for demonstration\"\n              >\n                <span className={`w-2 h-2 rounded-full ${statusStyle.dot}`} />\n                <span>Status: {complaint.status}</span>\n                <ChevronDown className=\"w-3.5 h-3.5 opacity-60 ml-0.5\" />\n              </button>\n\n              {showStatusMenu && (\n                <div className=\"absolute right-0 mt-1 w-48 bg-[#FAF9F6] border-2 border-[#1C1C1C] shadow-[3px_3px_0px_0px_#1C1C1C] z-30 py-1 text-xs font-mono\">\n                  <div className=\"px-3 py-1 text-[9px] font-bold uppercase tracking-wider text-[#1C1C1C]/60 border-b border-[#1C1C1C]/20\">\n                    Update Ledger Status\n                  </div>\n                  {([\'Submitted\', \'Under Review\', \'Resolved\'] as ComplaintStatus[]).map((st) => (\n                    <button\n                      key={st}\n                      type=\"button\"\n                      onClick={() => {\n                        onStatusChange(complaint.id, st);\n                        setShowStatusMenu(false);\n                      }}\n                      className={`w-full text-left px-3 py-2 flex items-center justify-between hover:bg-stone-200 cursor-pointer ${\n                        complaint.status === st ? \'font-bold bg-stone-200/80 text-red-700\' : \'text-[#1C1C1C]\'\n                      }`}\n                    >\n                      <span>{st}</span>\n                      {complaint.status === st && <CheckCircle2 className=\"w-3.5 h-3.5 text-red-700\" />}\n                    </button>\n                  ))}\n                </div>\n              )}\n            </div>\n          </div>\n\n          <h1 className=\"font-serif-editorial text-2xl sm:text-3xl font-bold text-[#1C1C1C] tracking-tight\">\n            Campus Grievance Deposition\n          </h1>\n\n          {/* Metadata Row */}\n          <div className=\"flex flex-wrap items-center gap-y-2 gap-x-4 text-xs font-mono text-[#1C1C1C]/70 mt-3 pt-3 border-t border-[#1C1C1C]/15\">\n            <div className=\"flex items-center gap-1.5 font-bold text-[#1C1C1C]\">\n              <MapPin className=\"w-3.5 h-3.5 text-red-700 shrink-0\" />\n              <span>{complaint.location}</span>\n            </div>\n\n            <div className=\"flex items-center gap-1.5\">\n              <span>\302\267</span>\n              <Clock className=\"w-3.5 h-3.5 shrink-0\" />\n              <span>Deposited {formatTimeAgo(complaint.createdAt)} ({formattedExactDate})</span>\n            </div>\n\n            <div className=\"flex items-center gap-1.5 text-emerald-800 font-bold ml-auto sm:ml-0\">\n              <span>\302\267</span>\n              <Lock className=\"w-3 h-3 text-red-700 shrink-0\" />\n              <span className=\"text-[11px] uppercase\">Cryptographic Identity Protected</span>\n            </div>\n          </div>\n        </div>\n\n        {/* Deposition Description Statement */}\n        <div className=\"mb-8\">\n          <h2 className=\"text-xs font-mono font-bold uppercase tracking-wider text-[#1C1C1C]/60 mb-2\">\n            Statement of Record\n          </h2>\n          <div className=\"bg-white border-2 border-[#1C1C1C] p-5 sm:p-6 shadow-[2px_2px_0px_0px_#1C1C1C]\">\n            <p className=\"font-serif text-base sm:text-lg text-[#1C1C1C] leading-relaxed whitespace-pre-line\">\n              {complaint.description}\n            </p>\n          </div>\n        </div>\n\n        {/* Evidence Photo Section (if available) */}\n        {complaint.photoUrl && (\n          <div className=\"mb-8\">\n            <h2 className=\"text-xs font-mono font-bold uppercase tracking-wider text-[#1C1C1C]/60 mb-2\">\n              Attached Photographic Evidence\n            </h2>\n            <div \n              onClick={() => onOpenImage(complaint.photoUrl!, `${complaint.id} - ${complaint.category}`)}\n              className=\"group relative bg-[#1C1C1C] border-2 border-[#1C1C1C] p-3 cursor-pointer overflow-hidden max-w-lg shadow-[3px_3px_0px_0px_#1C1C1C]\"\n            >\n              <img\n                src={complaint.photoUrl}\n                alt=\"Complaint Evidence\"\n                className=\"max-h-72 w-full object-contain mx-auto group-hover:opacity-90 transition-opacity\"\n                referrerPolicy=\"no-referrer\"\n              />\n              <div className=\"mt-2 text-center text-xs font-mono text-[#FAF9F6] flex items-center justify-center gap-1.5\">\n                <ImageIcon className=\"w-3.5 h-3.5 text-red-400\" />\n                <span>Click to inspect high-resolution evidence</span>\n                <ExternalLink className=\"w-3 h-3 ml-0.5 opacity-70\" />\n              </div>\n            </div>\n          </div>\n        )}\n\n        {/* Escalation & Status Progress Tracker */}\n        <div className=\"mb-8 bg-stone-100 border-2 border-[#1C1C1C] p-5 shadow-[2px_2px_0px_0px_#1C1C1C]\">\n          <h2 className=\"text-xs font-mono font-bold uppercase tracking-wider text-[#1C1C1C] mb-4\">\n            Escalation Lifecycle Pipeline\n          </h2>\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3\">\n            {/* Step 1: Deposited */}\n            <div className=\"p-3 bg-white border border-[#1C1C1C]/30 text-xs font-mono\">\n              <div className=\"flex items-center justify-between mb-1\">\n                <span className=\"font-bold text-[#1C1C1C]\">1. Deposited</span>\n                <CheckCircle2 className=\"w-4 h-4 text-emerald-700\" />\n              </div>\n              <p className=\"text-[11px] text-[#1C1C1C]/70\">Logged onto public ledger with ID {complaint.id}.</p>\n            </div>\n\n            {/* Step 2: Under Review */}\n            <div className={`p-3 border text-xs font-mono ${\n              complaint.status === \'Under Review\' || complaint.status === \'Resolved\'\n                ? \'bg-amber-50 border-amber-500 text-amber-950\'\n                : \'bg-white border-[#1C1C1C]/20 text-[#1C1C1C]/50\'\n            }`}>\n              <div className=\"flex items-center justify-between mb-1\">\n                <span className=\"font-bold\">2. Under Review</span>\n                {complaint.status === \'Under Review\' ? (\n                  <span className=\"w-2.5 h-2.5 rounded-full bg-amber-600 animate-pulse\" />\n                ) : complaint.status === \'Resolved\' ? (\n                  <CheckCircle2 className=\"w-4 h-4 text-emerald-700\" />\n                ) : null}\n              </div>\n              <p className=\"text-[11px]\">Assigned to relevant campus department/warden.</p>\n            </div>\n\n            {/* Step 3: Resolved */}\n            <div className={`p-3 border text-xs font-mono ${\n              complaint.status === \'Resolved\'\n                ? \'bg-emerald-50 border-emerald-500 text-emerald-950\'\n                : \'bg-white border-[#1C1C1C]/20 text-[#1C1C1C]/50\'\n            }`}>\n              <div className=\"flex items-center justify-between mb-1\">\n                <span className=\"font-bold\">3. Resolution</span>\n                {complaint.status === \'Resolved\' && (\n                  <CheckCircle2 className=\"w-4 h-4 text-emerald-700\" />\n                )}\n              </div>\n              <p className=\"text-[11px]\">Maintenance / administrative remedy completed.</p>\n            </div>\n          </div>\n        </div>\n\n        {/* Upvote & Action Bar */}\n        <div className=\"pt-6 border-t-2 border-[#1C1C1C] flex flex-col sm:flex-row items-center justify-between gap-4\">\n          {/* Upvote Button with disable behavior */}\n          <div className=\"flex items-center gap-3 w-full sm:w-auto\">\n            <button\n              id={`detail-upvote-btn-${complaint.id}`}\n              type=\"button\"\n              disabled={complaint.hasUpvoted}\n              onClick={handleUpvote}\n              className={`w-full sm:w-auto px-6 py-3 text-xs font-mono font-bold uppercase tracking-wider border-2 border-[#1C1C1C] transition-all cursor-pointer flex items-center justify-center gap-2.5 ${\n                complaint.hasUpvoted\n                  ? \'bg-emerald-800 text-white border-emerald-900 opacity-95 cursor-default\'\n                  : \'bg-[#1C1C1C] text-[#FAF9F6] hover:bg-stone-800 shadow-[3px_3px_0px_0px_#1C1C1C]\'\n              }`}\n            >\n              {complaint.hasUpvoted ? (\n                <>\n                  <Check className=\"w-4 h-4 stroke-[2.5]\" />\n                  <span>{complaint.upvotes} Endorsements (Upvoted)</span>\n                </>\n              ) : (\n                <>\n                  <ArrowBigUp className=\"w-4 h-4 stroke-[2.5]\" />\n                  <span>Endorse Grievance ({complaint.upvotes} Upvotes)</span>\n                </>\n              )}\n            </button>\n\n            <span className=\"text-[11px] font-mono text-[#1C1C1C]/60 hidden sm:inline\">\n              {complaint.hasUpvoted ? \'You have officially endorsed this issue.\' : \'Endorse to escalate attention.\'}\n            </span>\n          </div>\n\n          <div className=\"flex items-center gap-2.5 w-full sm:w-auto\">\n            <button\n              type=\"button\"\n              onClick={onBackToFeed}\n              className=\"w-full sm:w-auto px-5 py-3 text-xs font-mono font-bold uppercase tracking-wider border-2 border-[#1C1C1C] bg-white hover:bg-stone-100 transition-colors text-center cursor-pointer shadow-[2px_2px_0px_0px_#1C1C1C]\"\n            >\n              Back to Ledger\n            </button>\n\n            <button\n              type=\"button\"\n              onClick={onGoToSubmit}\n              className=\"w-full sm:w-auto px-5 py-3 text-xs font-mono font-bold uppercase tracking-wider border-2 border-[#1C1C1C] bg-white hover:bg-stone-100 transition-colors text-center cursor-pointer shadow-[2px_2px_0px_0px_#1C1C1C]\"\n            >\n              Lodge Another\n            </button>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    }
