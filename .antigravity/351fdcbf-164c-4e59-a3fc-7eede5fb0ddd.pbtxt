  file_change {
    absolute_path_uri: "file:///src/components/LandingPage.tsx"
    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "      {/* ========================================================================= */}\n      {/* 3. S.A.G.E. vs. PHYSICAL SUGGESTION BOX (SIDE-BY-SIDE COMPARISON) */}\n      {/* ========================================================================= */}\n      <section className=\"py-14 sm:py-20 px-4 sm:px-6 lg:px-8 border-b-2 border-[#1C1C1C] bg-[#FAF9F6]\">\n        <div className=\"max-w-6xl mx-auto\">\n          <div className=\"text-center max-w-3xl mx-auto mb-14\">\n            <div className=\"inline-flex items-center gap-2 text-xs font-mono font-bold uppercase tracking-widest text-[#1C1C1C]/70 mb-2\">\n              <Layers className=\"w-4 h-4 text-red-700\" />\n              <span>Modern Campus Governance</span>\n            </div>\n            <h2 className=\"font-serif-editorial text-3xl sm:text-5xl font-black text-[#1C1C1C] tracking-tight\">\n              Why S.A.G.E. Beats the Physical Suggestion Box\n            </h2>\n            <p className=\"font-serif italic text-base sm:text-lg text-[#1C1C1C]/75 mt-3\">\n              Traditional paper boxes are slow, unmonitored black holes. S.A.G.E. replaces them with transparency, community voice, and accountable workflows.\n            </p>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8\">\n            {/* The Old Way: Physical Box */}\n            <div className=\"bg-stone-100 border-2 border-stone-400 p-6 sm:p-8 shadow-[4px_4px_0px_0px_#78716c] relative\">\n              <div className=\"flex items-center justify-between gap-2 border-b border-stone-300 pb-3 mb-6\">\n                <div className=\"flex items-center gap-2\">\n                  <Inbox className=\"w-5 h-5 text-stone-500\" />\n                  <h3 className=\"font-mono text-sm font-bold uppercase tracking-wider text-stone-700\">\n                    Physical Suggestion Box\n                  </h3>\n                </div>\n                <span className=\"text-[10px] font-mono uppercase bg-stone-300 text-stone-700 px-2 py-0.5 font-bold\">\n                  Outdated\n                </span>\n              </div>\n\n              <ul className=\"space-y-4 text-xs sm:text-sm font-serif text-stone-600\">\n                <li className=\"flex items-start gap-3\">\n                  <span className=\"text-red-600 font-mono font-bold text-base leading-none\">\342\234\225</span>\n                  <div>\n                    <strong>Black hole of silence:</strong> You drop a paper slip and never know if it was read, discarded, or ignored.\n                  </div>\n                </li>\n                <li className=\"flex items-start gap-3\">\n                  <span className=\"text-red-600 font-mono font-bold text-base leading-none\">\342\234\225</span>\n                  <div>\n                    <strong>No community prioritization:</strong> Severe, widespread hostel issues are treated with the exact same slow priority as minor notes.\n                  </div>\n                </li>\n                <li className=\"flex items-start gap-3\">\n                  <span className=\"text-red-600 font-mono font-bold text-base leading-none\">\342\234\225</span>\n                  <div>\n                    <strong>Zero two-way communication:</strong> Authorities cannot post work order updates, contractor notes, or resolution dates.\n                  </div>\n                </li>\n                <li className=\"flex items-start gap-3\">\n                  <span className=\"text-red-600 font-mono font-bold text-base leading-none\">\342\234\225</span>\n                  <div>\n                    <strong>Compromised privacy:</strong> CCTV cameras over boxes and handwriting analysis create fear of exposure.\n                  </div>\n                </li>\n              </ul>\n            </div>\n\n            {/* The SAGE Way: Digital Protocol */}\n            <div className=\"bg-white border-3 border-[#1C1C1C] p-6 sm:p-8 shadow-[6px_6px_0px_0px_#1C1C1C] relative\">\n              <div className=\"flex items-center justify-between gap-2 border-b-2 border-[#1C1C1C] pb-3 mb-6\">\n                <div className=\"flex items-center gap-2\">\n                  <ShieldCheck className=\"w-5 h-5 text-red-700\" />\n                  <h3 className=\"font-mono text-sm font-bold uppercase tracking-wider text-[#1C1C1C]\">\n                    S.A.G.E. Digital Ledger\n                  </h3>\n                </div>\n                <span className=\"text-[10px] font-mono uppercase bg-red-700 text-white px-2 py-0.5 font-bold\">\n                  Transparent\n                </span>\n              </div>\n\n              <ul className=\"space-y-4 text-xs sm:text-sm font-serif text-[#1C1C1C]\">\n                <li className=\"flex items-start gap-3\">\n                  <CheckCircle2 className=\"w-4 h-4 text-emerald-700 shrink-0 mt-0.5\" />\n                  <div>\n                    <strong>Live Real-Time Tracking:</strong> Every submission receives a tracking ID (e.g. SAGE-2847) with live status updates (Submitted \342\206\222 Under Review \342\206\222 Resolved).\n                  </div>\n                </li>\n                <li className=\"flex items-start gap-3\">\n                  <CheckCircle2 className=\"w-4 h-4 text-emerald-700 shrink-0 mt-0.5\" />\n                  <div>\n                    <strong>Community Upvoting:</strong> Peers endorse critical complaints to amplify voice and push urgent issues to the top of the admin desk.\n                  </div>\n                </li>\n                <li className=\"flex items-start gap-3\">\n                  <CheckCircle2 className=\"w-4 h-4 text-emerald-700 shrink-0 mt-0.5\" />\n                  <div>\n                    <strong>Two-Way Administrative Remarks:</strong> Campus officials append resolution logs, technician notes, and completion timestamps directly onto the record.\n                  </div>\n                </li>\n                <li className=\"flex items-start gap-3\">\n                  <CheckCircle2 className=\"w-4 h-4 text-emerald-700 shrink-0 mt-0.5\" />\n                  <div>\n                    <strong>True Cryptographic Anonymity:</strong> Submit safely from any device with zero tracking, zero accounts, and zero metadata leakage.\n                  </div>\n                </li>\n              </ul>\n            </div>\n          </div>\n        </div>\n      </section>\n\n      {/* ========================================================================= */}\n      {/* 4. 3-STEP ESCALATION LIFECYCLE */}\n      {/* ========================================================================= */}\n      <section className=\"py-14 sm:py-20 px-4 sm:px-6 lg:px-8 border-b-2 border-[#1C1C1C] bg-white\">"
      replacement_content: "      {/* ========================================================================= */}\n      {/* 3. 3-STEP ESCALATION LIFECYCLE */}\n      {/* ========================================================================= */}\n      <section className=\"py-14 sm:py-20 px-4 sm:px-6 lg:px-8 border-b-2 border-[#1C1C1C] bg-[#FAF9F6]\">"
