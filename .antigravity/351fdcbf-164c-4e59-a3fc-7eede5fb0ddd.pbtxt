        target_content: "export function getCategoryBadgeStyle(category: ComplaintCategory): {\n  bg: string;\n  text: string;\n  border: string;\n  indicator: string;\n} {\n  switch (category) {\n    case \'Infrastructure\':\n      return {\n        bg: \'bg-stone-100\',\n        text: \'text-[#1C1C1C]\',\n        border: \'border-[#1C1C1C]/30\',\n        indicator: \'bg-[#1C1C1C]\',\n      };\n    case \'Mess/Food\':\n      return {\n        bg: \'bg-amber-50/80\',\n        text: \'text-amber-950\',\n        border: \'border-amber-900/30\',\n        indicator: \'bg-amber-800\',\n      };\n    case \'Harassment\':\n      return {\n        bg: \'bg-red-50\',\n        text: \'text-red-900\',\n        border: \'border-red-800/40\',\n        indicator: \'bg-red-700\',\n      };\n    case \'WiFi/Internet\':\n      return {\n        bg: \'bg-stone-100\',\n        text: \'text-stone-900\',\n        border: \'border-[#1C1C1C]/30\',\n        indicator: \'bg-stone-700\',\n      };\n    case \'Other\':\n    default:\n      return {\n        bg: \'bg-stone-50\',\n        text: \'text-stone-800\',\n        border: \'border-stone-400\',\n        indicator: \'bg-stone-600\',\n      };\n  }\n}\n\nexport function getStatusBadgeStyle(status: ComplaintStatus): {\n  bg: string;\n  text: string;\n  border: string;\n  dot: string;\n} {\n  switch (status) {\n    case \'Submitted\':\n      return {\n        bg: \'bg-stone-100\',\n        text: \'text-stone-800\',\n        border: \'border-stone-300\',\n        dot: \'bg-stone-600\',\n      };\n    case \'Under Review\':\n      return {\n        bg: \'bg-amber-100/90\',\n        text: \'text-amber-900\',\n        border: \'border-amber-400\',\n        dot: \'bg-amber-600 animate-pulse\',\n      };\n    case \'Resolved\':\n      return {\n        bg: \'bg-emerald-100/90\',\n        text: \'text-emerald-900\',\n        border: \'border-emerald-400\',\n        dot: \'bg-emerald-700\',\n      };\n  }\n}\n\nexport function generateComplaintId(): string {\n  const randomNum = Math.floor(1000 + Math.random() * 9000);\n  return `SAGE-${randomNum}`;\n}"
