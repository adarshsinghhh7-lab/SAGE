    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { PlusCircle, LayoutList, ShieldCheck, Lock } from \'lucide-react\';\nimport { PageView } from \'../types\';\n\ninterface NavbarProps {\n  currentView: PageView;\n  onNavigate: (view: PageView) => void;\n  totalComplaintsCount: number;\n}\n\nexport const Navbar: React.FC<NavbarProps> = ({\n  currentView,\n  onNavigate,\n  totalComplaintsCount,\n}) => {\n  return (\n    <header id=\"sage-header\" className=\"sticky top-0 z-30 bg-white/95 backdrop-blur-md border-b border-slate-200/80 shadow-xs\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-8 h-16 flex items-center justify-between\">\n        {/* Brand & Identity */}\n        <div \n          className=\"flex items-center gap-3 cursor-pointer select-none group\" \n          onClick={() => onNavigate(\'feed\')}\n        >\n          <div className=\"w-10 h-10 rounded-xl bg-blue-600 text-white flex items-center justify-center font-bold text-lg shadow-sm group-hover:bg-blue-700 transition-colors\">\n            S\n          </div>\n          <div>\n            <div className=\"flex items-center gap-2\">\n              <span className=\"text-lg font-bold tracking-tight text-slate-900\">\n                S.A.G.E.\n              </span>\n              <span className=\"inline-flex items-center gap-1 text-[10px] font-semibold uppercase tracking-wider bg-blue-50 text-blue-700 px-2 py-0.5 rounded-full border border-blue-200/60\">\n                <Lock className=\"w-2.5 h-2.5\" />\n                Anonymous\n              </span>\n            </div>\n            <p className=\"text-[11px] text-slate-500 font-medium hidden sm:block\">\n              Student Anonymous Grievance & Escalation\n            </p>\n          </div>\n        </div>\n\n        {/* Navigation Switcher */}\n        <nav className=\"flex items-center gap-2 sm:gap-3\">\n          <button\n            id=\"nav-submit-btn\"\n            type=\"button\"\n            onClick={() => onNavigate(\'submit\')}\n            className={`inline-flex items-center gap-1.5 px-3.5 sm:px-4 py-2 text-xs font-semibold rounded-xl transition-all cursor-pointer border ${\n              currentView === \'submit\' || currentView === \'confirmation\'\n                ? \'bg-blue-600 text-white border-blue-600 shadow-sm\'\n                : \'text-slate-600 hover:text-slate-900 border-slate-200 hover:bg-slate-50 bg-white\'\n            }`}\n          >\n            <PlusCircle className=\"w-4 h-4\" />\n            <span>Submit Grievance</span>\n          </button>\n\n          <button\n            id=\"nav-feed-btn\"\n            type=\"button\"\n            onClick={() => onNavigate(\'feed\')}\n            className={`inline-flex items-center gap-1.5 px-3.5 sm:px-4 py-2 text-xs font-semibold rounded-xl transition-all cursor-pointer border ${\n              currentView === \'feed\'\n                ? \'bg-slate-900 text-white border-slate-900 shadow-sm\'\n                : \'text-slate-600 hover:text-slate-900 border-slate-200 hover:bg-slate-50 bg-white\'\n            }`}\n          >\n            <LayoutList className=\"w-4 h-4\" />\n            <span>Public Board</span>\n            <span className={`text-[10px] font-mono font-bold px-1.5 py-0.5 rounded-md ${\n              currentView === \'feed\' ? \'bg-slate-800 text-white\' : \'bg-slate-100 text-slate-600\'\n            }`}>\n              {totalComplaintsCount}\n            </span>\n          </button>\n        </nav>\n      </div>\n    </header>\n  );\n};\n"
