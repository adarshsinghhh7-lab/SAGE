{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:backend": "node \"%npm_config_local_prefix%\\node_modules\\tsx\\dist\\cli.mjs\" watch backend/src/server.ts",
    "build": "npm --prefix frontend run build",
    "start": "node backend/dist/server.js",
    "preview": "npm --prefix frontend run preview",
    "clean": "rm -rf frontend/dist backend/dist server.js",
    "lint": "npm --prefix frontend run lint",
    "test:handler": "tsx scripts/smoke-test-handler.ts"
  },
  "dependencies": {
    "@types/cors": "^2.8.19",
    "cors": "^2.8.6",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase-admin": "^14.3.0",
    "serverless-http": "^3.2.0"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  },
  "overrides": {
    "jose": "5.9.6"
  }
}